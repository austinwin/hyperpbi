{
  "version": "2.0",
  "title": "Dynamic GIS Popup \u2014 Remote Analytics",
  "components": [
    {
      "type": "map",
      "id": "remote_sensor_map",
      "title": "Water pressure monitoring \u00b7 Houston",
      "basemap": {
        "type": "none"
      },
      "view": {
        "fitMode": "data",
        "zoom": 12
      },
      "featureDetails": {
        "mode": "auto"
      },
      "toolbar": {
        "visible": true,
        "home": true,
        "zoomIn": true,
        "zoomOut": true
      },
      "layers": [
        {
          "id": "sensors",
          "name": "Pressure sensors",
          "source": {
            "type": "geoJson",
            "data": {
              "type": "FeatureCollection",
              "features": [
                {
                  "type": "Feature",
                  "id": "1024",
                  "geometry": {
                    "type": "Point",
                    "coordinates": [
                      -95.382,
                      29.79
                    ]
                  },
                  "properties": {
                    "site_id": "1024",
                    "name": "North pressure station",
                    "latitude": 29.79,
                    "longitude": -95.382
                  }
                },
                {
                  "type": "Feature",
                  "id": "1025",
                  "geometry": {
                    "type": "Point",
                    "coordinates": [
                      -95.34,
                      29.752
                    ]
                  },
                  "properties": {
                    "site_id": "1025",
                    "name": "River pressure station",
                    "latitude": 29.752,
                    "longitude": -95.34
                  }
                },
                {
                  "type": "Feature",
                  "id": "1026",
                  "geometry": {
                    "type": "Point",
                    "coordinates": [
                      -95.427,
                      29.766
                    ]
                  },
                  "properties": {
                    "site_id": "1026",
                    "name": "West pressure station",
                    "latitude": 29.766,
                    "longitude": -95.427
                  }
                }
              ]
            }
          },
          "renderer": {
            "type": "simple",
            "symbol": {
              "shape": "circle",
              "fillColor": "#0f766e",
              "size": 16,
              "outlineColor": "#ffffff",
              "outlineWidth": 3
            }
          },
          "labels": {
            "enabled": true,
            "field": "name",
            "fieldSource": "service",
            "placement": "right",
            "color": "#0f766e",
            "size": 12
          },
          "tooltip": {
            "enabled": true,
            "template": "{{service.name}} \u00b7 Click for remote analytics"
          },
          "popup": {
            "mode": "remote",
            "title": "{{service.name}}",
            "remote": {
              "endpoint": "https://raw.githubusercontent.com/austinwin/hyperpbi/main/examples/remote-fragments/sensor-{{service.site_id}}.json",
              "cacheTtlSeconds": 30,
              "timeoutMs": 10000,
              "fallback": "attributes",
              "width": 540,
              "maxHeight": 560
            }
          },
          "interaction": {
            "enabled": true,
            "externalMode": "none"
          }
        }
      ],
      "heightMode": "fill",
      "minHeight": 280
    }
  ]
}
