            "id": "settings",
            "label": "Settings"
          }
        ],
        "visible": true,
        "width": 216
      },
      "stickyHeader": true
    },
    "calculations": {
      "metrics": [
        {
          "aggregation": "count",
          "key": "fleetcount"
        },
        {
          "aggregation": "countWhere",
          "key": "activerides",
          "where": {
            "left": {
              "field": "status"
            },
            "op": "=",
            "right": {
              "value": "Active"
            }
          }
        },
        {
          "aggregation": "avg",
          "field": "batterypct",
          "key": "averagebattery"
        },
        {
          "aggregation": "sum",
          "field": "ridership",
          "key": "totalridership"
        }
      ]
    },
    "components": [
      {
        "id": "mobilitymetrics",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "metrics": [
          {
            "format": "integer",
            "intent": "primary",
            "metric": "fleetcount",
            "title": "Fleet Assets"
          },
          {
            "format": "integer",
            "intent": "success",
            "metric": "activerides",
            "title": "Active Rides"
          },
          {
            "format": "integer",
            "intent": "warning",
            "metric": "averagebattery",
            "suffix": "%",
            "title": "Average Battery"
          },
          {
            "format": "integer",
            "intent": "primary",
            "metric": "totalridership",
            "title": "Total Ridership"
          }
        ],
        "span": 12,
        "type": "metricGrid"
      },
      {
        "basemap": {
          "type": "osm"
        },
        "height": 440,
        "id": "fleetmap",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "assetid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "layers": [
          {
            "id": "assets",
            "interaction": {
              "clearOnSecondClick": true,
              "enabled": true,
              "externalMode": "selection",
              "internalMode": "highlight",
              "internalScope": "others",
              "multiSelect": true,
              "selectionMode": "replace",
              "trigger": "click"
            },
            "legend": {
              "clickAction": "filterLayer",
              "interactive": true,
              "selectionMode": "multiple",
              "showCounts": true,
              "showPercentages": true
            },
            "name": "Fleet status",
            "renderer": {
              "defaultSymbol": {
                "fillColor": "#6857e5",
                "shape": "circle",
                "size": 8
              },
              "field": "status",
              "fieldSource": "powerbi",
              "type": "uniqueValue",
              "values": [
                {
                  "label": "Active",
                  "symbol": {
                    "fillColor": "#16c79a",
                    "outlineColor": "#ffffff",
                    "shape": "circle",
                    "size": 10
                  },
                  "value": "Active"
                },
                {
                  "label": "Charging",
                  "symbol": {
                    "fillColor": "#ffb703",
                    "outlineColor": "#ffffff",
                    "shape": "diamond",
                    "size": 11
                  },
                  "value": "Charging"
                },
                {
                  "label": "Maintenance",
                  "symbol": {
                    "fillColor": "#fa5c73",
                    "outlineColor": "#ffffff",
                    "shape": "square",
                    "size": 10
                  },
                  "value": "Maintenance"
                }
              ]
            },
            "source": {
              "bindings": {
                "color": "status",
                "latitude": "latitude",
                "longitude": "longitude",
                "size": "demandindex",
                "tooltip": [
                  "assetid",
                  "assettype",
                  "status",
                  "zone",
                  "batterypct"
                ]
              },
              "type": "powerbi"
            }
          }
        ],
        "span": 8,
        "title": "Live Fleet Distribution",
        "toolbar": {
          "clearSelection": true,
          "home": true,
          "layers": true,
          "legend": true,
          "selectedCount": true,
          "visible": true,
          "zoomToSelection": true
        },
        "type": "map",
        "view": {
          "fitMode": "data",
          "fitPadding": 0.08
        }
      },
      {
        "aggregation": "first",
        "category": "status",
        "dataset": "statusmix",
        "height": 210,
        "id": "fleetstatus",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "status",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "assets",
        "options": {
          "color": [
            "#16c79a",
            "#ffb703",
            "#fa5c73"
          ],
          "series": [
            {
              "radius": [
                "50%",
                "75%"
              ]
            }
          ]
        },
        "span": 4,
        "title": "Fleet Status",
        "type": "donutChart"
      },
      {
        "aggregation": "first",
        "category": "tripdate",
        "dataset": "dailyusage",
        "height": 210,
        "id": "usagewave",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "tripdate",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "rides",
        "options": {
          "color": [
            "#6857e5"
          ],
          "series": [
            {
              "areaStyle": {
                "opacity": 0.22
              },
              "lineStyle": {
                "width": 3
              },
              "smooth": true,
              "symbol": "none"
            }
          ]
        },
        "span": 4,
        "title": "Use of the Fleet",
        "type": "areaChart"
      },
      {
        "columns": [
          {
            "field": "route",
            "title": "Route"
          },
          {
            "field": "zone",
            "title": "Zone"
          },
          {
            "field": "rides",
            "format": "integer",
            "hozAlign": "right",
            "title": "Ridership"
          },
          {
            "cellType": "progress",
            "field": "averagedemand",
            "format": "integer",
            "title": "Demand"
          },
          {
            "field": "averagebattery",
            "format": "integer",
            "hozAlign": "right",
            "title": "Battery"
          }
        ],
        "dataset": "routesummary",
        "hover": true,
        "id": "routeperformance",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "route",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxRows": 10,
        "pagination": false,
        "span": 12,
        "striped": false,
        "title": "Busy Routes",
        "type": "table"
      }
    ],
    "css": "\n.hp-app-main { background:#f4f6fb; }\n.hp-page-header { border-bottom:0; background:#f4f6fb; }\n.hp-page-header-title { font-size:20px; letter-spacing:-.03em; }\n.hp-card { border:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric { border:0; border-left:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric-label { text-transform:none; letter-spacing:0; font-size:11px; }\n.hp-metric-value { font-size:23px; }\n.hp-card-header { border-bottom:1px solid color-mix(in srgb,var(--hp-border) 55%,transparent); }\n.hp-table-wrap { border-radius:var(--hp-radius); }\n.hp-app-footer { background:#f4f6fb; border-top:0; }\n\n.hp-app-main{background:#f2f3f8}.hp-sidebar-app{width:72px!important}.hp-sidebar-app .hp-nav-label,.hp-sidebar-footer{display:none}.hp-sidebar-app .hp-nav-item{justify-content:center;padding:11px}.hp-navbar-brand-subtitle{display:none}\n.hp-component-metricGrid .hp-metric{background:linear-gradient(135deg,#fff,#f7f5ff)}.hp-map-container{border-radius:12px;overflow:hidden}.hp-component-table .hp-card{box-shadow:none;border:1px solid #e4e6ef}\n",
    "data": {
      "datasets": {
        "dailyusage": {
          "groupBy": [
            "tripdate"
          ],
          "metrics": {
            "rides": {
              "field": "ridership",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "tripdate"
            }
          ],
          "source": "powerbi"
        },
        "routesummary": {
          "groupBy": [
            "route",
            "zone"
          ],
          "metrics": {
            "averagebattery": {
              "field": "batterypct",
              "op": "avg"
            },
            "averagedemand": {
              "field": "demandindex",
              "op": "avg"
            },
            "rides": {
              "field": "ridership",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "descending",
              "field": "rides"
            }
          ],
          "source": "powerbi"
        },
        "statusmix": {
          "groupBy": [
            "status"
          ],
          "metrics": {
            "assets": {
              "field": "assetid",
              "op": "count"
            }
          },
          "source": "powerbi"
        }
      }
    },
    "theme": {
      "accentColor": "#16c79a",
      "borderColor": "#e1e5ee",
      "cardPadding": 12,
      "dangerColor": "#fa5c73",
      "density": "compact",
      "gap": 10,
      "mode": "light",
      "primaryColor": "#6857e5",
      "radius": 12,
      "successColor": "#16c79a",
      "surfaceColor": "#ffffff",
      "textColor": "#25283d",
      "warningColor": "#ffb703"
    },
    "title": "Urban Mobility Command Center",
    "version": "2.0"
  }
}
