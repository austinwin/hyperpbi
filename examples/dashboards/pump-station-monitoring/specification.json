{
  "version": "2.0",
  "title": "Pump Station Monitoring",
  "theme": {
    "mode": "dark",
    "density": "compact",
    "primaryColor": "#54bcff",
    "accentColor": "#29b99a",
    "surfaceColor": "#101e2e",
    "textColor": "#e7f1ff",
    "borderColor": "#2b4159",
    "successColor": "#29b99a",
    "warningColor": "#efaa49",
    "radius": 12,
    "gap": 10
  },
  "app": {
    "enabled": true,
    "layout": "horizontal",
    "container": "fluid",
    "density": "compact",
    "brand": {
      "title": "Northbank Water",
      "shortTitle": "NW",
      "subtitle": "Operations",
      "icon": "dashboard"
    },
    "navbar": {
      "visible": true
    },
    "pageHeader": {
      "visible": true,
      "title": "Booster Station 07",
      "subtitle": "Pump station monitoring · Distribution operations",
      "meta": [
        {
          "label": "Telemetry",
          "value": "Simulated",
          "intent": "info"
        }
      ]
    }
  },
  "data": {
    "datasets": {
      "equipment_readings": {
        "source": "powerbi",
        "sort": [
          {
            "field": "sampleorder",
            "direction": "descending"
          }
        ]
      },
      "snapshots": {
        "source": "equipment_readings",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Snapshot"
        }
      },
      "pressure_history": {
        "source": "powerbi",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Trend"
        },
        "sort": [
          {
            "field": "sampleorder",
            "direction": "ascending"
          }
        ]
      }
    }
  },
  "styles": {
    "globalCss": "\n.hp-app-main,.hp-grid { background:#08111f; }\n.hp-navbar,.hp-sidebar-app,.hp-page-header,.hp-app-footer { background:#0b1525; border-color:#1c2a3d; }\n.hp-card,.hp-metric,.hp-custom-body,.hp-table-wrap { background:#0e1929; border-color:#203047; box-shadow:0 12px 30px rgb(0 0 0 / 22%); }\n.hp-card-header { border-color:#203047; }\n.hp-metric { border:1px solid #203047; border-left:0; }\n.hp-metric-label { color:#8596ad; text-transform:none; letter-spacing:0; }\n.hp-metric-value { color:#f5f8ff; font-size:23px; }\n.hp-table th { background:#111e30; color:#9fb0c7; }\n.hp-table td { border-color:#1b2a3d; }\n.hp-app-footer { border-top:1px solid #1c2a3d; }\n"
  },
  "components": [
    {
      "type": "segmentedControl",
      "id": "operating_scenario",
      "label": "Operating scenario",
      "field": "scenario",
      "options": [
        "Normal duty",
        "Peak demand",
        "Maintenance"
      ],
      "interaction": {
        "internalMode": "filter",
        "targets": [
          "station_scene",
          "station_online",
          "station_flow",
          "station_pressure",
          "station_alerts",
          "pressure_trend",
          "motor_load",
          "asset_register"
        ],
        "externalMode": "none"
      }
    },
    {
      "type": "grid",
      "id": "station_kpis",
      "columns": 12,
      "children": [
        {
          "type": "kpi",
          "id": "station_online",
          "title": "Pumps online",
          "dataset": "snapshots",
          "field": "stationonline",
          "aggregation": "first",
          "span": 3,
          "intent": "success"
        },
        {
          "type": "kpi",
          "id": "station_flow",
          "title": "Station flow (GPM)",
          "dataset": "snapshots",
          "field": "stationflow",
          "aggregation": "first",
          "span": 3
        },
        {
          "type": "kpi",
          "id": "station_pressure",
          "title": "Discharge pressure (PSI)",
          "dataset": "snapshots",
          "field": "stationpressure",
          "aggregation": "first",
          "span": 3
        },
        {
          "type": "kpi",
          "id": "station_alerts",
          "title": "Active alerts",
          "dataset": "snapshots",
          "field": "stationalerts",
          "aggregation": "first",
          "span": 3,
          "intent": "warning"
        }
      ]
    },
