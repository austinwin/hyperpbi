        "field": "equipmentid",
        "selectionMode": "replace",
        "multiSelect": true,
        "showSelector": false,
        "clearOnSecondClick": true,
        "targets": [
          "pressure_trend",
          "motor_load",
          "asset_register"
        ]
      }
    },
    {
      "type": "grid",
      "id": "station_trends",
      "columns": 12,
      "children": [
        {
          "type": "lineChart",
          "id": "pressure_trend",
          "title": "Discharge pressure · PSI",
          "dataset": "pressure_history",
          "category": "hour",
          "measure": "pressurepsi",
          "aggregation": "avg",
          "span": 7,
          "height": 270,
          "options": {
            "color": [
              "#58bcf4"
            ],
            "textStyle": {
              "color": "#dce8f8"
            },
            "legend": {
              "textStyle": {
