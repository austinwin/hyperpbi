                "color": "#758aa5"
              },
              "splitLine": {
                "lineStyle": {
                  "color": "#1c2b40"
                }
              },
              "axisLine": {
                "lineStyle": {
                  "color": "#263852"
                }
              }
            }
          },
          "interaction": {
            "enabled": true,
            "trigger": "click",
            "internalMode": "highlight",
            "internalScope": "others",
            "externalMode": "selection",
            "field": "equipmentid",
