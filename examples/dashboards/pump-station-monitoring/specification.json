                }
              }
            },
            "yAxis": {
              "axisLabel": {
                "color": "#758aa5"
              },
              "splitLine": {
                "lineStyle": {
                  "color": "#1c2b40"
                }
              },
              "axisLine": {
                "lineStyle": {
                  "color": "#263852"
                }
              }
            }
          },
          "interaction": {
            "enabled": false,
            "internalMode": "none",
            "externalMode": "none"
          }
        },
        {
          "type": "barChart",
          "id": "motor_load",
          "title": "Motor utilization · %",
          "dataset": "snapshots",
          "category": "equipmentid",
          "measure": "motorloadpct",
          "aggregation": "first",
          "span": 5,
          "height": 270,
          "options": {
            "color": [
              "#36c3ae"
            ],
            "textStyle": {
              "color": "#dce8f8"
            },
            "legend": {
              "textStyle": {
