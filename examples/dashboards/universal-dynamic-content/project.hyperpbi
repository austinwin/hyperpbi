  "metadata": {
    "createdAt": "2026-07-25T00:00:00.000Z",
    "id": "example-universal-dynamic-content",
    "name": "Universal Dynamic Content",
    "updatedAt": "2026-07-25T00:00:00.000Z"
  },
  "runtimeConfiguration": {
    "bindings": {
      "map": {}
    },
    "fields": {
      "aliases": {}
    },
    "interactions": {
      "crossFilter": true,
      "externalMode": "auto",
      "multiSelect": true
    },
    "motion": {
      "enabled": true,
      "maxConcurrentAnimations": 12,
      "reducedMotion": "respect-system"
    },
    "providers": {
      "basemap": {
        "enabled": false,
        "provider": "none"
      },
      "geocoder": {
        "autocomplete": false,
        "cache": true,
        "enabled": false,
        "minScore": 80,
        "provider": "none",
        "userTriggeredOnly": true
      },
      "mode": "maps",
      "privacyAcknowledged": false
    },
    "renderer": {
      "showHeader": false,
      "showRowCount": false,
      "showStudioButton": true
    },
    "security": {
      "cssMode": "scoped",
      "htmlMode": "sanitized",
      "showSanitizerWarnings": false,
      "svgMode": "sanitized"
    },
    "version": "1.0"
  },
  "specification": {
    "components": [
      {
        "children": [
          {
            "children": [
              {
                "field": "priority",
                "id": "priority",
                "interaction": {
                  "enabled": true,
                  "externalMode": "none",
                  "internalMode": "filter",
                  "targets": [
                    "assets"
                  ]
                },
                "options": [
                  "High",
                  "Normal"
                ],
                "title": "Work priority",
                "type": "select"
              },
              {
                "id": "refresh_workload",
                "title": "Refresh workload",
                "type": "button"
              }
            ],
            "gap": 12,
            "id": "work_controls",
            "type": "flex"
          },
          {
            "columns": [
              {
                "field": "assetid",
                "title": "Asset ID"
              },
              {
                "field": "asset",
                "title": "Equipment"
              },
              {
                "field": "zone",
                "title": "Zone"
              },
              {
                "field": "priority",
                "title": "Priority"
              }
            ],
            "hover": true,
            "id": "assets",
            "interaction": {
              "enabled": true,
              "externalMode": "none",
              "internalMode": "highlight",
              "internalScope": "self"
            },
            "title": "Assets",
            "type": "table"
          }
        ],
        "header": {
          "title": "Scheduled work orders"
        },
        "id": "work_queue",
        "type": "card"
      },
      {
        "children": [
          {
            "id": "workload",
            "loadOnMount": true,
            "request": {
              "cacheTtlSeconds": 30,
              "endpoint": "https://functions.miniup.app/hyperpbi-dynamic-demo/backlog?priority={{state.priority}}"
            },
            "title": "Workload",
            "trigger": {
              "event": "click",
              "refresh": true,
              "source": "refresh_workload"
            },
            "type": "dynamicContent"
          }
        ],
        "header": {
          "title": "Dispatch workload"
        },
        "id": "dispatch",
        "type": "card"
      }
    ],
    "rightPanel": [
      {
        "children": [
          {
            "emptyText": "Select a work order to see its assignment and scheduled tasks.",
            "id": "asset_details",
            "request": {
              "cacheTtlSeconds": 30,
              "endpoint": "https://functions.miniup.app/hyperpbi-dynamic-demo/asset?id={{context.assetid}}"
            },
            "title": "Asset details",
            "trigger": {
              "event": "click",
              "source": "assets"
            },
            "type": "dynamicContent"
          }
        ],
        "header": {
          "title": "Asset work plan"
        },
        "id": "asset_panel",
        "type": "card"
      }
    ],
    "theme": {
      "accentColor": "#0d9488",
      "cardPadding": 14,
      "density": "comfortable",
      "gap": 14,
      "mode": "light",
      "primaryColor": "#3156a8",
      "radius": 12
    },
    "title": "Universal Dynamic Content",
    "toolbar": [
      {
        "id": "work_intro",
        "text": "# Utility maintenance · Dispatch\n\nSelect an asset for its live work plan. Change the priority or refresh the workload to query the dispatch API.",
        "type": "markdown"
      }
    ],
    "version": "2.0"
  }
}
