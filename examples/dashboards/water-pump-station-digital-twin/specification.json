{
  "version": "2.0",
  "title": "Water Pump Station | Process Digital Twin",
  "theme": {
    "mode": "dark",
    "density": "compact",
    "primaryColor": "#63b6e5",
    "accentColor": "#2dd7bd",
    "surfaceColor": "#0d1b2b",
    "textColor": "#e9f4fb",
    "borderColor": "#29415b",
    "successColor": "#25bd9e",
    "warningColor": "#efa84e",
    "dangerColor": "#dc6873",
    "radius": 12,
    "gap": 10
  },
  "app": {
    "enabled": true,
    "layout": "horizontal",
    "container": "fluid",
    "density": "compact",
    "brand": {
      "title": "AquaGrid",
      "shortTitle": "AG",
      "subtitle": "Station engineering",
      "icon": "dashboard"
    },
    "navbar": {
      "visible": true
    },
    "pageHeader": {
      "visible": true,
      "title": "Water Pump Station | Process Digital Twin",
      "subtitle": "Sources • treatment • five storage tanks • six booster pumps • distribution",
      "meta": [
        {
          "label": "Training model",
          "value": "Synthetic scenarios",
          "intent": "info"
        }
      ]
    }
  },
  "data": {
    "datasets": {
      "readings": {
        "source": "powerbi",
        "sort": [
          {
            "field": "sampleorder",
            "direction": "descending"
          }
        ]
      },
      "snapshots": {
        "source": "readings",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Snapshot"
        }
      },
      "boosters": {
        "source": "snapshots",
        "filter": {
          "field": "category",
          "operator": "=",
          "value": "Booster"
        }
      },
      "storage": {
        "source": "snapshots",
        "filter": {
          "field": "category",
          "operator": "=",
          "value": "Storage"
        }
      },
      "trends": {
        "source": "powerbi",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Trend"
        },
        "sort": [
          {
            "field": "sampleorder",
            "direction": "ascending"
          }
        ]
      }
    }
  },
  "styles": {
    "globalCss": "\n.hp-app-main,.hp-grid { background:#07121e; }\n.hp-navbar,.hp-page-header { background:#0a1828; border-color:#22384f; }\n.hp-card,.hp-metric,.hp-table-wrap { background:#102237; border-color:#2b4159; box-shadow:0 8px 28px rgb(0 0 0 / 20%); }\n.hp-metric { border:1px solid #29415b; border-left:0; }\n.hp-metric-label { color:#8da9c0; text-transform:none; }\n.hp-metric-value { color:#f0faff; font-size:23px; }\n.hp-table th { background:#122a42; color:#a8c1d3; }\n.hp-card-header { border-color:#2b4159; }\n"
  },
  "components": [
    {
      "type": "segmentedControl",
      "id": "operating_scenario",
      "label": "Operating scenario",
      "field": "scenario",
      "options": [
        "Normal supply",
        "Peak demand",
        "Remote wells offline",
        "Surface inlet unavailable",
        "Booster maintenance",
        "Low storage",
        "Limited power",
        "Low distribution pressure"
      ],
      "interaction": {
        "internalMode": "filter",
        "targets": [
          "water_scene",
          "flow_kpi",
          "pressure_kpi",
          "pumps_kpi",
          "storage_kpi",
          "alerts_kpi",
          "source_kpi",
          "flow_history",
          "pressure_history",
          "booster_load",
          "storage_levels",
          "asset_register"
        ],
        "externalMode": "none"
      }
    },
    {
      "type": "text",
      "id": "process_legend",
      "text": "SOURCE NETWORK  →  GROUND STORAGE  →  BOOSTER ARRAY  →  DISTRIBUTION | Teal: raw/source flows • Blue: transfer/discharge • Green: running • Amber: warning. All values are simulated and are not operational guidance."
    },
    {
      "type": "grid",
      "id": "station_kpis",
      "columns": 12,
      "children": [
        {
          "type": "kpi",
          "id": "flow_kpi",
          "title": "Discharge flow (GPM)",
          "dataset": "snapshots",
          "field": "stationflow",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "pressure_kpi",
          "title": "Discharge (PSI)",
          "dataset": "snapshots",
          "field": "stationpressure",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "pumps_kpi",
          "title": "Boosters online",
          "dataset": "snapshots",
          "field": "stationonline",
          "aggregation": "first",
          "span": 2,
          "intent": "success"
        },
        {
          "type": "kpi",
          "id": "storage_kpi",
          "title": "Mean GST level (%)",
          "dataset": "snapshots",
          "field": "averagelevel",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "source_kpi",
          "title": "Source intake (GPM)",
          "dataset": "snapshots",
          "field": "sourceflow",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "alerts_kpi",
          "title": "Active alerts",
          "dataset": "snapshots",
          "field": "stationalerts",
          "aggregation": "first",
          "span": 2,
          "intent": "warning"
        }
      ]
    },
    {
      "type": "scene3d",
      "id": "water_scene",
      "dataset": "snapshots",
      "title": "Process route | sources → storage → boosters → distribution",
      "objectIdField": "assetid",
      "flowField": "flowgpm",
      "levelField": "levelpct",
      "statusField": "status",
      "colorField": "equipmentcolor",
      "statusColors": [
        {
          "value": "Running",
          "color": "#31c8a4"
        },
        {
          "value": "Warning",
          "color": "#f7ab50"
        },
        {
          "value": "Standby",
          "color": "#7789a0"
        },
        {
          "value": "Offline",
          "color": "#d77378"
        }
      ],
      "tooltipFields": [
