  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "AG",
        "subtitle": "Station engineering",
        "title": "AquaGrid"
      },
      "container": "fluid",
      "density": "compact",
      "enabled": true,
      "layout": "horizontal",
      "navbar": {
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "intent": "info",
            "label": "Training model",
            "value": "Synthetic scenarios"
          }
        ],
        "subtitle": "Sources • treatment • five storage tanks • six booster pumps • distribution",
        "title": "Water Pump Station | Process Digital Twin",
        "visible": true
      }
    },
    "components": [
      {
        "field": "scenario",
        "id": "operating_scenario",
        "interaction": {
          "externalMode": "none",
          "internalMode": "filter",
          "targets": [
            "water_scene",
            "flow_kpi",
            "pressure_kpi",
            "pumps_kpi",
            "storage_kpi",
            "alerts_kpi",
            "source_kpi",
            "flow_history",
            "pressure_history",
            "booster_load",
            "storage_levels",
            "asset_register"
          ]
        },
        "label": "Operating scenario",
        "options": [
          "Normal supply",
          "Peak demand",
          "Remote wells offline",
          "Surface inlet unavailable",
          "Booster maintenance",
          "Low storage",
          "Limited power",
          "Low distribution pressure"
        ],
        "type": "segmentedControl"
      },
      {
        "id": "process_legend",
        "text": "SOURCE NETWORK  →  GROUND STORAGE  →  BOOSTER ARRAY  →  DISTRIBUTION | Teal: raw/source flows • Blue: transfer/discharge • Green: running • Amber: warning. All values are simulated and are not operational guidance.",
        "type": "text"
      },
      {
        "children": [
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationflow",
            "id": "flow_kpi",
            "span": 2,
            "title": "Discharge flow (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationpressure",
            "id": "pressure_kpi",
            "span": 2,
            "title": "Discharge (PSI)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationonline",
            "id": "pumps_kpi",
            "intent": "success",
            "span": 2,
            "title": "Boosters online",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "averagelevel",
            "id": "storage_kpi",
            "span": 2,
            "title": "Mean GST level (%)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "sourceflow",
            "id": "source_kpi",
            "span": 2,
            "title": "Source intake (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationalerts",
            "id": "alerts_kpi",
            "intent": "warning",
            "span": 2,
            "title": "Active alerts",
            "type": "kpi"
          }
        ],
        "columns": 12,
        "id": "station_kpis",
        "type": "grid"
