    "data": {
      "datasets": {
        "boosters": {
          "filter": {
            "field": "category",
            "operator": "=",
            "value": "Booster"
          },
          "source": "snapshots"
        },
        "readings": {
          "sort": [
            {
              "direction": "descending",
              "field": "sampleorder"
            }
          ],
          "source": "powerbi"
        },
        "snapshots": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Snapshot"
          },
          "source": "readings"
        },
        "storage": {
          "filter": {
            "field": "category",
            "operator": "=",
            "value": "Storage"
          },
          "source": "snapshots"
        },
        "trends": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Trend"
          },
          "sort": [
