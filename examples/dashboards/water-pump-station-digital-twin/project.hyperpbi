  "format": "hyperpbi-playground-project",
  "formatVersion": 1,
  "metadata": {
    "createdAt": "2026-07-25T00:00:00.000Z",
    "id": "example-water-pump-station-digital-twin",
    "name": "Water Pump Station | Process Digital Twin",
    "updatedAt": "2026-07-25T00:00:00.000Z"
  },
  "runtimeConfiguration": {
    "bindings": {
      "map": {}
    },
    "fields": {
      "aliases": {}
    },
    "interactions": {
      "crossFilter": true,
      "externalMode": "auto",
      "multiSelect": true
    },
    "motion": {
      "enabled": true,
      "maxConcurrentAnimations": 24,
      "reducedMotion": "respect-system"
    },
    "providers": {
      "basemap": {
        "enabled": false,
        "provider": "none"
      },
      "geocoder": {
        "autocomplete": false,
        "cache": true,
        "enabled": false,
        "minScore": 80,
        "provider": "none",
        "userTriggeredOnly": true
      },
      "mode": "core",
      "privacyAcknowledged": false
    },
    "renderer": {
      "showHeader": false,
      "showRowCount": false,
      "showStudioButton": true
    },
    "security": {
      "cssMode": "scoped",
      "htmlMode": "sanitized",
      "showSanitizerWarnings": false
    },
    "version": "1.0"
  },
  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "AG",
        "subtitle": "Station engineering",
        "title": "AquaGrid"
      },
      "container": "fluid",
      "density": "compact",
      "enabled": true,
      "layout": "horizontal",
      "navbar": {
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "intent": "info",
            "label": "Training model",
            "value": "Synthetic scenarios"
          }
        ],
        "subtitle": "Well and surface metering • chlorine / ammonia dosing • 5 GSTs • 6 boosters • quality monitoring",
        "title": "Water Pump Station | Process Digital Twin",
        "visible": true
      }
    },
    "components": [
      {
        "field": "scenario",
        "id": "operating_scenario",
        "interaction": {
          "externalMode": "none",
          "internalMode": "filter",
          "targets": [
            "water_scene",
            "flow_kpi",
            "pressure_kpi",
            "pumps_kpi",
            "storage_kpi",
            "alerts_kpi",
            "source_kpi",
            "storage_balance_kpi",
            "chlorine_kpi",
            "ammonia_kpi",
            "flow_history",
            "pressure_history",
            "booster_load",
            "storage_levels",
            "source_meter_chart",
            "quality_chart",
            "asset_register",
            "meter_register",
            "chemical_register"
          ]
        },
        "label": "Operating scenario (choose one state)",
        "options": [
          "Normal supply",
          "Peak demand",
          "Remote wells offline",
          "Surface inlet unavailable",
          "Booster maintenance",
          "Low storage",
          "Limited power",
          "Low distribution pressure",
          "Chlorine dosing fault",
          "Ammonia dosing fault"
        ],
        "type": "select"
      },
      {
        "id": "process_legend",
        "text": "PROCESS: 8 remote wells + 1 on-site well + 2 surface inlets → Cl2 / NH3 injection and chlorine monitoring → 5 GSTs → 6 booster pumps → distribution Cl2 / NH3 analyzer. Teal: well water • Blue: surface/treated water • Gold: Cl2 • Violet: NH3. Flow markers follow signed GPM. Select one scenario before reading the KPIs: All combines unrelated training states.",
        "type": "text"
      },
      {
        "children": [
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationflow",
            "id": "flow_kpi",
            "span": 2,
            "title": "Discharge flow (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationpressure",
            "id": "pressure_kpi",
            "span": 2,
            "title": "Discharge (PSI)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationonline",
            "id": "pumps_kpi",
            "intent": "success",
            "span": 2,
            "title": "Boosters online",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "averagelevel",
            "id": "storage_kpi",
            "span": 2,
            "title": "Mean GST level (%)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "sourceflow",
            "id": "source_kpi",
            "span": 2,
            "title": "Source intake (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationalerts",
            "id": "alerts_kpi",
            "intent": "warning",
            "span": 2,
            "title": "Active alerts",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "netstoragegpm",
            "id": "storage_balance_kpi",
            "span": 4,
            "title": "Storage net rate (GPM, + filling)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "distribution_quality",
            "field": "cl2mgL",
            "id": "chlorine_kpi",
            "span": 4,
            "title": "Distribution Cl2 (mg/L)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "distribution_quality",
            "field": "nh3mgL",
            "id": "ammonia_kpi",
            "span": 4,
            "title": "Distribution NH3 (mg/L)",
            "type": "kpi"
          }
        ],
        "columns": 12,
        "id": "station_kpis",
        "type": "grid"
      },
      {
        "colorField": "equipmentcolor",
        "dataset": "snapshots",
        "flowField": "flowgpm",
        "grid": true,
        "height": 760,
        "id": "water_scene",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "assetid",
          "internalMode": "filter",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "targets": [
            "asset_register",
            "meter_register",
            "chemical_register",
            "booster_load",
            "storage_levels",
            "source_meter_chart",
            "quality_chart"
          ],
          "trigger": "click"
        },
        "levelField": "levelpct",
        "objectIdField": "assetid",
