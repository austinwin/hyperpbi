    "components": [
      {
        "dataset": "account",
        "id": "bankmetrics",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "metrics": [
          {
            "aggregation": "first",
            "field": "balance",
            "format": "currency",
            "intent": "primary",
            "title": "Total Balance"
          },
          {
            "aggregation": "first",
            "field": "debit",
            "format": "currency",
            "intent": "danger",
            "title": "Debit"
          },
          {
            "aggregation": "first",
            "field": "credit",
            "format": "currency",
            "intent": "success",
            "title": "Credit"
          }
        ],
        "responsive": {
          "lg": {
            "span": 8
          },
          "xs": {
            "span": 12
          }
        },
        "span": 8,
        "type": "metricGrid"
      },
      {
        "dataset": "account",
        "id": "paymentcard",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "repeat": {
          "limit": 1,
          "source": "rows",
          "template": "<article class='payment-card'><header><strong>Paycent</strong><span>contactless</span></header><b>6219&nbsp;&nbsp;8610&nbsp;&nbsp;2888&nbsp;&nbsp;{{row.cardlast4}}</b><footer><span>{{row.cardholder}}</span><span>{{row.expiry}}</span></footer></article>"
        },
        "responsive": {
          "lg": {
            "span": 4
          },
          "xs": {
            "span": 12
          }
        },
        "span": 4,
        "type": "custom"
      },
      {
        "category": "month",
        "dataset": "monthly",
        "height": 290,
        "id": "transactionreport",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "month",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "options": {
          "color": [
            "#2596ff",
            "#24d2ed"
          ],
          "legend": {
            "textStyle": {
              "color": "#8fa3bc"
            }
          },
          "series": [
            {
              "barWidth": 24,
              "itemStyle": {
                "borderRadius": [
                  8,
                  8,
                  2,
                  2
                ]
              }
            },
            {
              "lineStyle": {
                "width": 3
              },
              "smooth": true,
              "symbolSize": 7
            }
          ],
          "textStyle": {
            "color": "#dce8f8"
          },
          "xAxis": {
            "axisLabel": {
              "color": "#758aa5"
            },
            "axisLine": {
              "lineStyle": {
                "color": "#263852"
              }
            }
          },
          "yAxis": {
            "axisLabel": {
              "color": "#758aa5"
            },
            "axisLine": {
              "lineStyle": {
                "color": "#263852"
              }
            },
            "splitLine": {
              "lineStyle": {
                "color": "#1c2b40"
              }
            }
          }
        },
        "responsive": {
          "lg": {
            "span": 8
          },
          "xs": {
            "span": 12
          }
        },
        "series": [
          {
            "aggregation": "first",
            "chartType": "bar",
            "field": "debits",
            "label": "Debit"
          },
          {
            "aggregation": "first",
            "chartType": "line",
            "field": "credits",
            "label": "Credit"
          }
        ],
        "span": 8,
        "title": "Transaction Reports",
        "type": "comboChart"
      },
      {
        "aggregation": "first",
        "category": "category",
        "dataset": "expenses",
        "height": 290,
        "id": "expensesdonut",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "category",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "spend",
        "options": {
          "color": [
            "#2596ff",
            "#24d2ed",
            "#d81b71",
            "#965cf8"
          ],
          "legend": {
            "textStyle": {
              "color": "#8fa3bc"
            }
          },
          "series": [
            {
              "label": {
                "show": false
              },
              "radius": [
                "52%",
                "76%"
              ]
            }
          ],
          "textStyle": {
            "color": "#dce8f8"
          },
          "xAxis": {
            "axisLabel": {
              "color": "#758aa5"
            },
            "axisLine": {
              "lineStyle": {
                "color": "#263852"
              }
            }
          },
          "yAxis": {
            "axisLabel": {
              "color": "#758aa5"
            },
            "axisLine": {
              "lineStyle": {
                "color": "#263852"
              }
            },
            "splitLine": {
              "lineStyle": {
                "color": "#1c2b40"
              }
            }
          }
        },
        "responsive": {
          "lg": {
            "span": 4
          },
          "xs": {
            "span": 12
          }
        },
        "span": 4,
        "title": "Expenses",
        "type": "donutChart"
      },
      {
        "columns": [
          {
            "field": "merchant",
            "title": "Account"
          },
          {
            "field": "category",
            "title": "Category"
          },
          {
            "field": "amount",
            "format": "currency",
            "hozAlign": "right",
            "title": "Amount"
          },
          {
            "field": "date",
            "title": "Date"
          },
          {
            "cellType": "badge",
            "field": "status",
            "intentMap": {
              "Pending": "warning",
              "Success": "success"
            },
            "title": "Status"
          },
          {
            "field": "channel",
            "title": "Channel"
          }
        ],
        "dataset": "recent",
        "hover": true,
        "id": "recenttransactions",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "recordid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxRows": 10,
        "pagination": false,
        "span": 12,
        "title": "Recent Transactions",
        "type": "table"
      }
    ],
    "css": "\n.hp-app-main,.hp-grid { background:#08111f; }\n.hp-navbar,.hp-sidebar-app,.hp-page-header,.hp-app-footer { background:#0b1525; border-color:#1c2a3d; }\n.hp-card,.hp-metric,.hp-custom-body,.hp-table-wrap { background:#0e1929; border-color:#203047; box-shadow:0 12px 30px rgb(0 0 0 / 22%); }\n.hp-card-header { border-color:#203047; }\n.hp-metric { border:1px solid #203047; border-left:0; }\n.hp-metric-label { color:#8596ad; text-transform:none; letter-spacing:0; }\n.hp-metric-value { color:#f5f8ff; font-size:23px; }\n.hp-table th { background:#111e30; color:#9fb0c7; }\n.hp-table td { border-color:#1b2a3d; }\n.hp-app-footer { border-top:1px solid #1c2a3d; }\n\n.hp-app-shell{color-scheme:dark}.hp-navbar-search input{background:#091321;border-color:#26364d;color:#edf5ff}.hp-sidebar-app .hp-nav-active{background:linear-gradient(90deg,#258dff,#0764cd);color:#fff}.hp-component-metricGrid .hp-metric{background:linear-gradient(145deg,#101c2d,#0b1422)}.hp-component-metricGrid .hp-metric:first-child{border-color:#2596ff}\n.payment-card{min-height:154px;display:flex;flex-direction:column;justify-content:space-between;padding:20px;border-radius:18px;color:#fff;background:radial-gradient(circle at 85% 110%,#ff59d1,transparent 38%),radial-gradient(circle at 5% -10%,#29d3ff,transparent 42%),linear-gradient(135deg,#11104a,#17082e);box-shadow:0 18px 35px rgb(0 0 0 / 28%)}.payment-card header,.payment-card footer{display:flex;justify-content:space-between;align-items:center}.payment-card header span{font-size:9px;color:#bcd1e7}.payment-card b{font-size:17px;letter-spacing:.12em}.payment-card footer{font-size:10px;color:#dbe7fa}\n",
    "data": {
      "datasets": {
        "account": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Account"
          },
          "source": "powerbi"
        },
        "expenses": {
          "filter": {
            "field": "transactiontype",
            "operator": "=",
            "value": "Debit"
          },
          "groupBy": [
            "category"
          ],
          "metrics": {
            "spend": {
              "field": "amount",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "descending",
              "field": "spend"
            }
          ],
          "source": "transactions"
        },
        "monthly": {
          "derive": {
            "creditamount": {
              "condition": {
                "left": {
                  "field": "transactiontype"
                },
                "op": "=",
                "right": {
                  "value": "Credit"
                }
              },
              "else": {
                "value": 0
              },
              "op": "if",
              "then": {
                "field": "amount"
              }
            },
            "debitamount": {
              "condition": {
                "left": {
                  "field": "transactiontype"
                },
                "op": "=",
                "right": {
                  "value": "Debit"
                }
              },
              "else": {
                "value": 0
              },
              "op": "if",
              "then": {
                "field": "amount"
              }
            }
          },
          "groupBy": [
            "month",
            "monthorder"
          ],
          "metrics": {
            "credits": {
              "field": "creditamount",
              "op": "sum"
            },
            "debits": {
              "field": "debitamount",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "monthorder"
            }
          ],
          "source": "transactions"
        },
        "recent": {
          "limit": 10,
          "sort": [
            {
              "direction": "descending",
              "field": "date"
            }
          ],
          "source": "transactions"
        },
        "transactions": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Transaction"
          },
          "source": "powerbi"
        }
      }
    },
    "theme": {
      "accentColor": "#24d2ed",
      "borderColor": "#203047",
      "cardPadding": 14,
      "dangerColor": "#d81b71",
      "density": "compact",
      "gap": 12,
      "mode": "dark",
      "primaryColor": "#2596ff",
      "radius": 12,
      "successColor": "#15bc88",
      "surfaceColor": "#0e1929",
      "textColor": "#eef5ff",
      "warningColor": "#ff9c35"
    },
    "title": "Digital Banking Overview",
    "version": "2.0"
  }
