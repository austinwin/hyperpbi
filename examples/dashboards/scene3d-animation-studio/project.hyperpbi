  "editorState": {
    "studioLayout": "{\"editorPercent\":38,\"bottomHeight\":210,\"bottomOpen\":true,\"advanced\":false}"
  },
  "format": "hyperpbi-playground-project",
  "formatVersion": 1,
  "metadata": {
    "createdAt": "2026-07-25T00:00:00.000Z",
    "id": "example-scene3d-animation-studio",
    "name": "3D Animation Studio",
    "updatedAt": "2026-07-25T00:00:00.000Z"
  },
  "runtimeConfiguration": {
    "bindings": {
      "map": {}
    },
    "fields": {
      "aliases": {}
    },
    "interactions": {
      "crossFilter": true,
      "externalMode": "auto",
      "multiSelect": true
    },
    "motion": {
      "enabled": true,
      "maxConcurrentAnimations": 8,
      "reducedMotion": "respect-system"
    },
    "providers": {
      "basemap": {
        "enabled": false,
        "provider": "none"
      },
      "geocoder": {
        "autocomplete": false,
        "cache": true,
        "enabled": false,
        "minScore": 80,
        "provider": "none",
        "userTriggeredOnly": true
      },
      "mode": "core",
      "privacyAcknowledged": false
    },
    "renderer": {
      "showHeader": false,
      "showRowCount": false,
      "showStudioButton": true
    },
    "security": {
      "cssMode": "scoped",
      "htmlMode": "sanitized",
      "showSanitizerWarnings": false,
      "svgMode": "sanitized"
    },
    "version": "1.0"
  },
  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "NW",
        "subtitle": "Operations",
        "title": "Northbank Water"
      },
      "container": "fluid",
      "density": "compact",
      "enabled": true,
      "layout": "horizontal",
      "navbar": {
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "intent": "info",
            "label": "Telemetry",
            "value": "Simulated"
          }
        ],
        "subtitle": "Rotating cooling fans, reciprocating actuator, status beacons and live data bindings",
        "title": "Interactive 3D Animation Studio",
        "visible": true
      }
    },
    "components": [
      {
        "field": "scenario",
        "id": "operating_scenario",
        "interaction": {
          "externalMode": "none",
          "internalMode": "filter",
          "targets": [
            "station_scene",
            "station_online",
            "station_flow",
            "station_pressure",
            "station_alerts",
            "pressure_trend",
            "motor_load",
            "asset_register"
          ]
        },
        "label": "Operating scenario",
        "options": [
          "Normal duty",
          "Peak demand",
          "Maintenance"
        ],
        "type": "segmentedControl"
      },
      {
        "id": "motion_guide",
        "text": "Choose an operating scenario, then watch motor-driven fans spin, a warning light pulse, and a stopped pump's beacon blink. Select any 3D asset to filter the linked charts. Open Visual Inspector to edit or add animations without writing code.",
        "type": "text"
      },
      {
        "children": [
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationonline",
            "id": "station_online",
            "intent": "success",
            "span": 3,
            "title": "Pumps online",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationflow",
            "id": "station_flow",
            "span": 3,
            "title": "Station flow (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationpressure",
            "id": "station_pressure",
            "span": 3,
            "title": "Discharge pressure (PSI)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "stationalerts",
            "id": "station_alerts",
            "intent": "warning",
            "span": 3,
            "title": "Active alerts",
            "type": "kpi"
          }
        ],
        "columns": 12,
        "id": "station_kpis",
        "type": "grid"
      },
      {
        "dataset": "equipment_readings",
        "height": 490,
        "id": "station_scene",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "equipmentid",
          "internalMode": "filter",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "targets": [
            "pressure_trend",
            "motor_load",
            "asset_register"
          ],
          "trigger": "click"
        },
        "objectIdField": "equipmentid",
