            "label": "Equipment"
          },
          {
            "field": "flowgpm",
            "label": "Flow (GPM)"
          },
          {
            "field": "pressurepsi",
            "label": "Pressure (PSI)"
          },
          {
            "field": "motorloadpct",
            "label": "Motor load (%)"
          }
        ],
        "type": "scene3d"
      },
      {
        "children": [
          {
            "aggregation": "avg",
            "category": "hour",
            "dataset": "pressure_history",
            "height": 270,
            "id": "pressure_trend",
            "interaction": {
              "enabled": false,
              "externalMode": "none",
              "internalMode": "none"
            },
            "measure": "pressurepsi",
            "options": {
              "color": [
                "#58bcf4"
              ],
              "legend": {
                "textStyle": {
                  "color": "#8fa3bc"
                }
              },
              "textStyle": {
                "color": "#dce8f8"
              },
              "xAxis": {
                "axisLabel": {
                  "color": "#758aa5"
                },
                "axisLine": {
                  "lineStyle": {
                    "color": "#263852"
                  }
                }
              },
              "yAxis": {
                "axisLabel": {
                  "color": "#758aa5"
                },
                "axisLine": {
                  "lineStyle": {
                    "color": "#263852"
                  }
                },
                "splitLine": {
                  "lineStyle": {
                    "color": "#1c2b40"
                  }
                }
              }
            },
            "span": 7,
            "title": "Discharge pressure · PSI",
            "type": "lineChart"
          },
          {
            "aggregation": "first",
            "category": "equipmentid",
            "dataset": "snapshots",
            "height": 270,
            "id": "motor_load",
            "interaction": {
              "clearOnSecondClick": true,
              "enabled": true,
              "externalMode": "selection",
              "field": "equipmentid",
              "internalMode": "highlight",
              "internalScope": "others",
              "multiSelect": true,
              "selectionMode": "replace",
              "showSelector": false,
              "targets": [
                "station_scene"
              ],
              "trigger": "click"
            },
            "measure": "motorloadpct",
            "options": {
              "color": [
                "#36c3ae"
              ],
              "legend": {
                "textStyle": {
                  "color": "#8fa3bc"
                }
              },
              "textStyle": {
                "color": "#dce8f8"
              },
              "xAxis": {
                "axisLabel": {
                  "color": "#758aa5"
                },
                "axisLine": {
                  "lineStyle": {
                    "color": "#263852"
                  }
                }
              },
              "yAxis": {
                "axisLabel": {
                  "color": "#758aa5"
                },
                "axisLine": {
                  "lineStyle": {
                    "color": "#263852"
                  }
                },
                "splitLine": {
                  "lineStyle": {
                    "color": "#1c2b40"
                  }
                }
              }
            },
            "span": 5,
            "title": "Motor utilization · %",
            "type": "barChart"
          }
        ],
        "columns": 12,
        "id": "station_trends",
        "type": "grid"
      },
      {
        "columns": [
          {
            "field": "equipmentid",
            "title": "Asset"
          },
          {
            "field": "equipment",
            "title": "Equipment"
          },
          {
            "field": "scenario",
            "title": "Scenario"
          },
          {
            "field": "status",
            "title": "Status"
          },
          {
            "field": "flowgpm",
            "title": "Flow (GPM)"
          },
          {
            "field": "pressurepsi",
            "title": "Pressure (PSI)"
          },
          {
            "field": "motorloadpct",
            "title": "Motor load (%)"
          }
        ],
        "dataset": "snapshots",
        "id": "asset_register",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "equipmentid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "targets": [
            "station_scene"
          ],
          "trigger": "click"
        },
        "maxRows": 12,
        "title": "Snapshot register",
        "type": "table"
      }
    ],
    "data": {
      "datasets": {
        "equipment_readings": {
          "sort": [
            {
              "direction": "descending",
              "field": "sampleorder"
            }
          ],
          "source": "powerbi"
        },
        "pressure_history": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Trend"
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "sampleorder"
            }
          ],
          "source": "powerbi"
        },
        "snapshots": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Snapshot"
          },
          "source": "equipment_readings"
        }
      }
    },
    "styles": {
      "globalCss": "\n.hp-app-main,.hp-grid { background:#08111f; }\n.hp-navbar,.hp-sidebar-app,.hp-page-header,.hp-app-footer { background:#0b1525; border-color:#1c2a3d; }\n.hp-card,.hp-metric,.hp-custom-body,.hp-table-wrap { background:#0e1929; border-color:#203047; box-shadow:0 12px 30px rgb(0 0 0 / 22%); }\n.hp-card-header { border-color:#203047; }\n.hp-metric { border:1px solid #203047; border-left:0; }\n.hp-metric-label { color:#8596ad; text-transform:none; letter-spacing:0; }\n.hp-metric-value { color:#f5f8ff; font-size:23px; }\n.hp-table th { background:#111e30; color:#9fb0c7; }\n.hp-table td { border-color:#1b2a3d; }\n.hp-app-footer { border-top:1px solid #1c2a3d; }\n"
    },
    "theme": {
      "accentColor": "#29b99a",
      "borderColor": "#2b4159",
      "density": "compact",
      "gap": 10,
      "mode": "dark",
      "primaryColor": "#54bcff",
      "radius": 12,
      "successColor": "#29b99a",
      "surfaceColor": "#101e2e",
      "textColor": "#e7f1ff",
      "warningColor": "#efaa49"
    },
    "title": "3D Animation Studio",
    "version": "2.0"
  }
