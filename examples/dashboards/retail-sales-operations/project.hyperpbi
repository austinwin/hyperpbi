    "components": [
      {
        "dataset": "summary",
        "id": "retailmetrics",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "metrics": [
          {
            "aggregation": "first",
            "field": "revenue",
            "format": "currency",
            "intent": "danger",
            "title": "Total Sales"
          },
          {
            "aggregation": "first",
            "field": "dailyusers",
            "format": "integer",
            "intent": "success",
            "title": "Daily User"
          },
          {
            "aggregation": "first",
            "field": "newproducts",
            "format": "integer",
            "intent": "primary",
            "title": "New Products"
          },
          {
            "aggregation": "first",
            "field": "expense",
            "format": "currency",
            "intent": "warning",
            "title": "Expenses"
          },
          {
            "aggregation": "first",
            "field": "balance",
            "format": "currency",
            "intent": "danger",
            "title": "Active Balance"
          }
        ],
        "span": 12,
        "type": "metricGrid"
      },
      {
        "aggregation": "first",
        "category": "month",
        "dataset": "monthly",
        "height": 285,
        "id": "summarysales",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "month",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "sales",
        "options": {
          "color": [
            "#ff704f"
          ],
          "series": [
            {
              "areaStyle": {
                "opacity": 0.16
              },
              "lineStyle": {
                "width": 3
              },
              "smooth": true,
              "symbolSize": 7
            }
          ]
        },
        "span": 8,
        "title": "Summary Sales",
        "type": "areaChart"
      },
      {
        "aggregation": "first",
        "category": "category",
        "dataset": "categories",
        "height": 285,
        "id": "salesmix",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "category",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "sales",
        "options": {
          "color": [
            "#ff704f",
            "#23b39a",
            "#3ca6e8",
            "#ffb84d"
          ],
          "series": [
            {
              "radius": [
                "52%",
                "76%"
              ]
            }
          ]
        },
        "span": 4,
        "title": "Sales Mix",
        "type": "donutChart"
      },
      {
        "columns": [
          {
            "field": "customer",
            "title": "Customer"
          },
          {
            "field": "product",
            "title": "Product"
          },
          {
            "field": "date",
            "title": "Date"
          },
          {
            "field": "revenue",
            "format": "currency",
            "hozAlign": "right",
            "title": "Price"
          },
          {
            "cellType": "badge",
            "field": "orderstatus",
            "intentMap": {
              "Complete": "success",
              "Pending": "warning",
              "Processing": "primary"
            },
            "title": "Status"
          }
        ],
        "dataset": "recentorders",
        "hover": true,
        "id": "lastorders",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "recordid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxRows": 10,
        "pagination": false,
        "span": 8,
        "title": "Last Orders",
        "type": "table"
      },
      {
        "compact": false,
        "dataset": "payments",
        "id": "upcomingpayments",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "provider",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxItems": 6,
        "primaryField": "provider",
        "secondaryField": "duedate",
        "source": "rows",
        "span": 4,
        "title": "Upcoming Payments",
        "type": "listGroup",
        "valueField": "dueamount"
      }
    ],
    "css": "\n.hp-app-main { background:#f4f6fb; }\n.hp-page-header { border-bottom:0; background:#f4f6fb; }\n.hp-page-header-title { font-size:20px; letter-spacing:-.03em; }\n.hp-card { border:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric { border:0; border-left:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric-label { text-transform:none; letter-spacing:0; font-size:11px; }\n.hp-metric-value { font-size:23px; }\n.hp-card-header { border-bottom:1px solid color-mix(in srgb,var(--hp-border) 55%,transparent); }\n.hp-table-wrap { border-radius:var(--hp-radius); }\n.hp-app-footer { background:#f4f6fb; border-top:0; }\n\n.hp-sidebar-app{background:#354b87;color:#f4f7ff;border:0}.hp-sidebar-app .hp-nav-item,.hp-sidebar-footer-title{color:#f4f7ff}.hp-sidebar-app .hp-sidebar-footer-subtitle{color:#b9c5e5}.hp-sidebar-app .hp-nav-item:hover{background:rgb(255 255 255 / 10%)}.hp-sidebar-app .hp-nav-active{background:rgb(255 255 255 / 14%);color:#fff}\n.hp-component-metricGrid .hp-metric{position:relative;padding-top:42px}.hp-component-metricGrid .hp-metric::before{content:\"\";position:absolute;left:16px;top:13px;width:24px;height:24px;border-radius:50%;background:color-mix(in srgb,var(--hp-intent,var(--hp-primary)) 18%,transparent);box-shadow:inset 0 0 0 6px color-mix(in srgb,var(--hp-intent,var(--hp-primary)) 8%,transparent)}\n.hp-list-item{margin-bottom:7px;border:0;border-radius:8px;background:#f7f8fc}.hp-list-item-value{color:#ff704f}\n",
    "data": {
      "datasets": {
        "categories": {
          "groupBy": [
            "category"
          ],
          "metrics": {
            "sales": {
              "field": "revenue",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "descending",
              "field": "sales"
            }
          ],
          "source": "orders"
        },
        "monthly": {
          "groupBy": [
            "month",
            "monthorder"
          ],
          "metrics": {
            "costs": {
              "field": "expense",
              "op": "sum"
            },
            "sales": {
              "field": "revenue",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "monthorder"
            }
          ],
          "source": "orders"
        },
        "orders": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Order"
          },
          "source": "powerbi"
        },
        "payments": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Payment"
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "duedate"
            }
          ],
          "source": "powerbi"
        },
        "recentorders": {
          "limit": 10,
          "sort": [
            {
              "direction": "descending",
              "field": "date"
            }
          ],
          "source": "orders"
        },
        "summary": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Summary"
          },
          "source": "powerbi"
        }
      }
    },
    "theme": {
      "accentColor": "#23b39a",
      "borderColor": "#dfe5f2",
      "cardPadding": 14,
      "dangerColor": "#ff704f",
      "density": "compact",
      "gap": 12,
      "mode": "light",
      "primaryColor": "#ff704f",
      "radius": 12,
      "successColor": "#23b39a",
      "surfaceColor": "#ffffff",
      "textColor": "#252944",
      "warningColor": "#ffb84d"
    },
    "title": "Retail Sales Operations",
    "version": "2.0"
  }
}
