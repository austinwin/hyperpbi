          "internalMode": "none"
        },
        "metrics": [
          {
            "aggregation": "first",
            "field": "throughput",
            "intent": "success",
            "suffix": " Gbps",
            "title": "Throughput"
          },
          {
            "aggregation": "first",
            "field": "latency",
            "intent": "warning",
            "suffix": " ms",
            "title": "Latency"
          },
          {
            "aggregation": "first",
            "field": "packetloss",
            "intent": "danger",
            "suffix": "%",
            "title": "Packet Loss"
          },
          {
            "aggregation": "first",
            "field": "uptime",
            "intent": "success",
            "suffix": "%",
            "title": "Uptime"
          }
        ],
        "span": 12,
        "type": "metricGrid"
