      {
        "html": "<header class='telemetry-header'><div><span>INDUSTRIAL NETWORK</span><h1>Telemetry Control</h1></div><nav><b>Live</b><b>48 samples</b><b>8 nodes</b></nav></header>",
        "id": "telemetryheader",
