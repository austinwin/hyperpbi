                  "lineStyle": {
                    "color": "#263852"
                  }
                },
                "splitLine": {
                  "lineStyle": {
                    "color": "#1c2b40"
                  }
                }
              }
            },
            "span": 4,
            "title": "Snapshot flow by asset · GPM",
            "type": "barChart"
          },
          {
            "aggregation": "first",
            "category": "hour",
            "chartStyle": {
              "series": [
                {
                  "smooth": true
                }
              ],
              "yAxis": [
                {
                  "domain": "fixed",
                  "max": 100,
                  "min": 0,
                  "suffix": "%"
                }
              ]
            },
            "dataset": "storage_history",
            "height": 270,
            "id": "groundwater_level_history",
            "interaction": {
              "enabled": false,
              "externalMode": "none",
              "internalMode": "none"
            },
            "measure": "levelpct",
            "options": {
              "color": [
