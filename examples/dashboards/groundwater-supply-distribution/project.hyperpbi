  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "RW",
        "subtitle": "Groundwater operations",
        "title": "Ridgeway Water"
      },
      "container": "fluid",
      "density": "compact",
      "enabled": true,
      "layout": "horizontal",
      "navbar": {
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "intent": "info",
            "label": "Telemetry",
            "value": "Simulated"
          }
        ],
        "subtitle": "Local well and remote well → treatment → distribution pump → residential service",
        "title": "Groundwater Supply & Distribution",
        "visible": true
      }
    },
    "components": [
      {
        "field": "scenario",
        "id": "groundwater_scenario",
        "interaction": {
          "externalMode": "none",
          "internalMode": "filter",
          "targets": [
            "groundwater_scene",
            "groundwater_wells",
            "groundwater_raw",
            "groundwater_delivered",
            "groundwater_pressure",
            "groundwater_level",
            "groundwater_flow",
            "groundwater_by_asset",
            "groundwater_assets",
            "groundwater_level_history"
          ]
        },
        "label": "Operating scenario",
        "options": [
          "Normal flow",
          "Remote well offline",
          "Peak demand"
        ],
        "type": "segmentedControl"
      },
      {
        "children": [
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "wellsactive",
            "id": "groundwater_wells",
            "span": 2,
            "title": "Active source wells",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "rawgpm",
            "id": "groundwater_raw",
            "span": 2,
            "title": "Plant intake (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "deliveredgpm",
            "id": "groundwater_delivered",
            "span": 2,
            "title": "Residential delivery (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "mainpsi",
            "id": "groundwater_pressure",
            "span": 3,
            "title": "Distribution main (PSI)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "storage_snapshot",
            "field": "levelpct",
            "id": "groundwater_level",
            "span": 3,
            "title": "Clearwell level (%)",
            "type": "kpi"
          }
        ],
        "columns": 12,
        "id": "groundwater_kpis",
        "type": "grid"
      },
      {
        "id": "groundwater_legend",
        "text": "Teal pipes carry raw groundwater. Blue pipes carry treated water. Green pumps are running and red pumps are stopped. Select the Clearwell tank to inspect its water level.",
        "type": "text"
      },
      {
        "colorField": "equipmentcolor",
        "dataset": "asset_readings",
        "flowField": "flowgpm",
        "height": 455,
        "id": "groundwater_scene",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "assetid",
          "internalMode": "filter",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "targets": [
            "groundwater_flow",
            "groundwater_by_asset",
            "groundwater_assets"
          ],
          "trigger": "click"
        },
        "levelField": "levelpct",
        "objectIdField": "assetid",
