          },
          {
            "field": "stage",
            "title": "Stage"
          },
          {
            "field": "scenario",
            "title": "Scenario"
          },
          {
            "field": "status",
            "title": "Status"
          },
          {
            "field": "flowgpm",
            "title": "Flow (GPM)"
          },
          {
            "field": "levelpct",
            "title": "Tank level (%)"
          }
        ],
        "dataset": "snapshots",
        "id": "groundwater_assets",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "assetid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "targets": [
            "groundwater_scene"
          ],
          "trigger": "click"
        },
        "maxRows": 24,
        "title": "Source-to-tap asset register",
        "type": "table"
      }
    ],
    "data": {
      "datasets": {
        "asset_readings": {
          "sort": [
            {
              "direction": "descending",
              "field": "sampleorder"
            }
          ],
          "source": "powerbi"
        },
        "flow_history": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Trend"
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "sampleorder"
            }
          ],
          "source": "powerbi"
        },
        "snapshots": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Snapshot"
          },
          "source": "asset_readings"
        },
        "storage_history": {
          "filter": {
            "field": "assetid",
            "operator": "=",
            "value": "CW-01"
          },
          "source": "flow_history"
        },
        "storage_snapshot": {
          "filter": {
            "field": "assetid",
            "operator": "=",
            "value": "CW-01"
          },
          "source": "snapshots"
        }
      }
    },
    "styles": {
      "globalCss": "\n.hp-app-main,.hp-grid { background:#08111f; }\n.hp-navbar,.hp-sidebar-app,.hp-page-header,.hp-app-footer { background:#0b1525; border-color:#1c2a3d; }\n.hp-card,.hp-metric,.hp-custom-body,.hp-table-wrap { background:#0e1929; border-color:#203047; box-shadow:0 12px 30px rgb(0 0 0 / 22%); }\n.hp-card-header { border-color:#203047; }\n.hp-metric { border:1px solid #203047; border-left:0; }\n.hp-metric-label { color:#8596ad; text-transform:none; letter-spacing:0; }\n.hp-metric-value { color:#f5f8ff; font-size:23px; }\n.hp-table th { background:#111e30; color:#9fb0c7; }\n.hp-table td { border-color:#1b2a3d; }\n.hp-app-footer { border-top:1px solid #1c2a3d; }\n"
    },
    "theme": {
      "borderColor": "#2b4159",
      "density": "compact",
      "gap": 10,
      "mode": "dark",
      "primaryColor": "#6eb5ff",
      "radius": 12,
      "surfaceColor": "#101e2e",
      "textColor": "#e7f1ff"
    },
    "title": "Groundwater Supply & Distribution",
    "version": "2.0"
  }
