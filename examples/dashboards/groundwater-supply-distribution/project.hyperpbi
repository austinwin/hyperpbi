            "label": "Flow (GPM)"
          }
        ],
        "type": "scene3d"
      },
      {
        "children": [
          {
            "aggregation": "avg",
            "category": "hour",
            "dataset": "flow_history",
            "height": 270,
            "id": "groundwater_flow",
            "interaction": {
              "enabled": false,
              "externalMode": "none",
              "internalMode": "none"
            },
            "measure": "flowgpm",
            "options": {
              "color": [
                "#6eb5ff"
              ],
              "legend": {
                "textStyle": {
                  "color": "#8fa3bc"
                }
              },
              "textStyle": {
                "color": "#dce8f8"
              },
              "xAxis": {
                "axisLabel": {
