                  }
                }
              }
            },
            "span": 4,
            "title": "Mean flow profile · GPM",
            "type": "lineChart"
          },
          {
            "aggregation": "first",
            "category": "assetid",
            "dataset": "snapshots",
            "height": 270,
            "id": "groundwater_by_asset",
            "interaction": {
              "clearOnSecondClick": true,
              "enabled": true,
              "externalMode": "selection",
              "field": "assetid",
              "internalMode": "highlight",
              "internalScope": "others",
              "multiSelect": true,
              "selectionMode": "replace",
              "showSelector": false,
              "targets": [
                "groundwater_scene"
              ],
              "trigger": "click"
            },
            "measure": "flowgpm",
            "options": {
              "color": [
                "#57cebb"
              ],
              "legend": {
                "textStyle": {
                  "color": "#8fa3bc"
                }
              },
              "textStyle": {
                "color": "#dce8f8"
              },
              "xAxis": {
                "axisLabel": {
                  "color": "#758aa5"
                },
                "axisLine": {
                  "lineStyle": {
