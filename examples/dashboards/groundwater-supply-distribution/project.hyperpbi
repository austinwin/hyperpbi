  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "RW",
        "subtitle": "Groundwater operations",
        "title": "Ridgeway Water"
      },
      "container": "fluid",
      "density": "compact",
      "enabled": true,
      "layout": "horizontal",
      "navbar": {
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "intent": "info",
            "label": "Telemetry",
            "value": "Simulated"
          }
        ],
        "subtitle": "Local well and remote well → treatment → distribution pump → residential service",
        "title": "Groundwater Supply & Distribution",
        "visible": true
      }
    },
    "components": [
      {
        "field": "scenario",
        "id": "groundwater_scenario",
        "interaction": {
          "externalMode": "none",
          "internalMode": "filter",
          "targets": [
            "groundwater_scene",
            "groundwater_wells",
            "groundwater_raw",
            "groundwater_delivered",
            "groundwater_pressure",
            "groundwater_flow",
            "groundwater_by_asset",
            "groundwater_assets"
          ]
        },
        "label": "Operating scenario",
        "options": [
          "Normal flow",
          "Remote well offline",
          "Peak demand"
        ],
        "type": "segmentedControl"
      },
      {
        "children": [
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "wellsactive",
            "id": "groundwater_wells",
            "span": 3,
            "title": "Active source wells",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "rawgpm",
            "id": "groundwater_raw",
            "span": 3,
            "title": "Plant intake (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "deliveredgpm",
            "id": "groundwater_delivered",
            "span": 3,
            "title": "Residential delivery (GPM)",
            "type": "kpi"
          },
          {
            "aggregation": "first",
            "dataset": "snapshots",
            "field": "mainpsi",
            "id": "groundwater_pressure",
            "span": 3,
            "title": "Distribution main (PSI)",
            "type": "kpi"
          }
        ],
        "columns": 12,
        "id": "groundwater_kpis",
        "type": "grid"
      },
      {
        "id": "groundwater_legend",
        "text": "Teal pipes carry raw groundwater. Blue pipes carry treated water. Select a well, plant, pump, or house to trace its readings.",
        "type": "text"
      },
