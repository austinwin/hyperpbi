{
  "version": "2.0",
  "title": "Groundwater Supply & Distribution",
  "theme": {
    "mode": "dark",
    "density": "compact",
    "primaryColor": "#6eb5ff",
    "surfaceColor": "#101e2e",
    "textColor": "#e7f1ff",
    "borderColor": "#2b4159",
    "radius": 12,
    "gap": 10
  },
  "app": {
    "enabled": true,
    "layout": "horizontal",
    "container": "fluid",
    "density": "compact",
    "brand": {
      "title": "Ridgeway Water",
      "shortTitle": "RW",
      "subtitle": "Groundwater operations",
      "icon": "dashboard"
    },
    "navbar": {
      "visible": true
    },
    "pageHeader": {
      "visible": true,
      "title": "Groundwater Supply & Distribution",
      "subtitle": "Local well and remote well → treatment → distribution pump → residential service",
      "meta": [
        {
          "label": "Telemetry",
          "value": "Simulated",
          "intent": "info"
        }
      ]
    }
  },
  "data": {
    "datasets": {
      "asset_readings": {
        "source": "powerbi",
        "sort": [
          {
            "field": "sampleorder",
            "direction": "descending"
          }
        ]
      },
      "snapshots": {
        "source": "asset_readings",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Snapshot"
        }
      },
      "flow_history": {
        "source": "powerbi",
        "filter": {
          "field": "recordtype",
          "operator": "=",
          "value": "Trend"
        },
        "sort": [
          {
            "field": "sampleorder",
            "direction": "ascending"
          }
        ]
      },
      "storage_snapshot": {
        "source": "snapshots",
        "filter": {
          "field": "assetid",
          "operator": "=",
          "value": "CW-01"
        }
      },
      "storage_history": {
        "source": "flow_history",
        "filter": {
          "field": "assetid",
          "operator": "=",
          "value": "CW-01"
        }
      }
    }
  },
  "styles": {
    "globalCss": "\n.hp-app-main,.hp-grid { background:#08111f; }\n.hp-navbar,.hp-sidebar-app,.hp-page-header,.hp-app-footer { background:#0b1525; border-color:#1c2a3d; }\n.hp-card,.hp-metric,.hp-custom-body,.hp-table-wrap { background:#0e1929; border-color:#203047; box-shadow:0 12px 30px rgb(0 0 0 / 22%); }\n.hp-card-header { border-color:#203047; }\n.hp-metric { border:1px solid #203047; border-left:0; }\n.hp-metric-label { color:#8596ad; text-transform:none; letter-spacing:0; }\n.hp-metric-value { color:#f5f8ff; font-size:23px; }\n.hp-table th { background:#111e30; color:#9fb0c7; }\n.hp-table td { border-color:#1b2a3d; }\n.hp-app-footer { border-top:1px solid #1c2a3d; }\n"
  },
  "components": [
    {
      "type": "segmentedControl",
      "id": "groundwater_scenario",
      "label": "Operating scenario",
      "field": "scenario",
      "options": [
        "Normal flow",
        "Remote well offline",
        "Peak demand"
      ],
      "interaction": {
        "internalMode": "filter",
        "targets": [
          "groundwater_scene",
          "groundwater_wells",
          "groundwater_raw",
          "groundwater_delivered",
          "groundwater_pressure",
          "groundwater_level",
          "groundwater_flow",
          "groundwater_by_asset",
          "groundwater_assets",
          "groundwater_level_history"
        ],
        "externalMode": "none"
      }
    },
    {
      "type": "grid",
      "id": "groundwater_kpis",
      "columns": 12,
      "children": [
        {
          "type": "kpi",
          "id": "groundwater_wells",
          "title": "Active source wells",
          "field": "wellsactive",
          "dataset": "snapshots",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "groundwater_raw",
          "title": "Plant intake (GPM)",
          "field": "rawgpm",
          "dataset": "snapshots",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "groundwater_delivered",
          "title": "Residential delivery (GPM)",
          "field": "deliveredgpm",
          "dataset": "snapshots",
          "aggregation": "first",
          "span": 2
        },
        {
          "type": "kpi",
          "id": "groundwater_pressure",
          "title": "Distribution main (PSI)",
          "field": "mainpsi",
          "dataset": "snapshots",
          "aggregation": "first",
          "span": 3
        },
        {
          "type": "kpi",
          "id": "groundwater_level",
          "title": "Clearwell level (%)",
          "field": "levelpct",
          "dataset": "storage_snapshot",
          "aggregation": "first",
          "span": 3
        }
      ]
    },
    {
      "type": "text",
      "id": "groundwater_legend",
      "text": "Teal pipes carry raw groundwater. Blue pipes carry treated water. Green pumps are running and red pumps are stopped. Select the Clearwell tank to inspect its water level."
    },
