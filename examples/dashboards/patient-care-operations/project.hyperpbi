    "id": "example-patient-care-operations",
    "name": "Patient Care Operations",
    "updatedAt": "2026-07-25T00:00:00.000Z"
  },
  "runtimeConfiguration": {
    "bindings": {
      "map": {}
    },
    "fields": {
      "aliases": {}
    },
    "interactions": {
      "crossFilter": true,
      "externalMode": "auto",
      "multiSelect": true
    },
    "motion": {
      "enabled": true,
      "maxConcurrentAnimations": 12,
      "reducedMotion": "respect-system"
    },
    "providers": {
      "basemap": {
        "enabled": false,
        "provider": "none"
      },
      "geocoder": {
        "autocomplete": false,
        "cache": true,
        "enabled": false,
        "minScore": 80,
        "provider": "none",
        "userTriggeredOnly": true
      },
      "mode": "core",
      "privacyAcknowledged": false
    },
    "renderer": {
      "showHeader": false,
      "showRowCount": false,
      "showStudioButton": true
    },
    "security": {
      "cssMode": "scoped",
      "htmlMode": "sanitized",
      "showSanitizerWarnings": false
    },
    "version": "1.0"
  },
  "specification": {
    "app": {
      "brand": {
        "icon": "dashboard",
        "shortTitle": "CA",
        "subtitle": "Patient operations",
        "title": "CareFlow"
      },
      "container": "fluid",
      "contentPadding": "compact",
      "density": "compact",
      "enabled": true,
      "footer": {
        "secondaryText": "One portable dataset · Web and Power BI",
        "text": "CareFlow · HyperPBI",
        "visible": true
      },
      "layout": "vertical",
      "navbar": {
        "actions": [
          {
            "action": {
              "durationMs": 2200,
              "intent": "primary",
              "message": "The current dataset is displayed.",
              "title": "CareFlow",
              "type": "showToast"
            },
            "ariaLabel": "Refresh dashboard",
            "icon": "refresh",
            "id": "refresh"
          },
          {
            "action": {
              "durationMs": 2200,
              "intent": "warning",
              "message": "Three items need attention.",
              "title": "Notifications",
              "type": "showToast"
            },
            "ariaLabel": "Notifications",
            "badge": 3,
            "icon": "bell",
            "id": "notifications"
          }
        ],
        "searchPlaceholder": "Search this dashboard",
        "showSearch": true,
        "showSidebarToggle": true,
        "user": {
          "initials": "DO",
          "name": "Dashboard Owner",
          "status": "online",
          "subtitle": "Workspace admin"
        },
        "visible": true
      },
      "pageHeader": {
        "meta": [
          {
            "icon": "check",
            "intent": "success",
            "label": "Data",
            "value": "Current"
          }
        ],
        "subtitle": "Alerts, patient flow, and service response across the care network",
        "title": "Patient Activity",
        "visible": true
      },
      "sidebar": {
        "collapsedWidth": 62,
        "collapsible": true,
        "defaultCollapsed": false,
        "footer": {
          "subtitle": "Portable HyperPBI example",
          "title": "CareFlow"
        },
        "mobileBreakpoint": 760,
        "navigation": [
          {
            "action": {
              "durationMs": 1600,
              "intent": "primary",
              "message": "Overview is already open.",
              "title": "Activity",
              "type": "showToast"
            },
            "icon": "activity",
            "id": "activity",
            "label": "Activity"
          },
          {
            "action": {
              "durationMs": 1600,
              "intent": "primary",
              "message": "This example focuses on the overview.",
              "title": "Patients",
              "type": "showToast"
            },
            "icon": "users",
            "id": "patients",
            "label": "Patients"
          },
          {
            "action": {
              "durationMs": 1600,
              "intent": "primary",
              "message": "This example focuses on the overview.",
              "title": "Reviews",
              "type": "showToast"
            },
            "icon": "message",
            "id": "reviews",
            "label": "Reviews"
          },
          {
            "action": {
              "durationMs": 1600,
              "intent": "primary",
              "message": "This example focuses on the overview.",
              "title": "Calendar",
              "type": "showToast"
            },
            "icon": "calendar",
            "id": "calendar",
            "label": "Calendar"
          }
        ],
        "visible": true,
        "width": 216
      },
      "stickyHeader": true
    },
    "calculations": {
      "metrics": [
        {
          "aggregation": "count",
          "key": "encounters"
        },
        {
          "aggregation": "distinctCount",
          "field": "patientid",
          "key": "patients"
        },
        {
          "aggregation": "countWhere",
          "key": "openalerts",
          "where": {
            "left": {
              "field": "status"
            },
            "op": "!=",
            "right": {
              "value": "Resolved"
            }
          }
        },
        {
          "aggregation": "avg",
          "field": "responseminutes",
          "key": "averageresponse"
        }
      ]
    },
    "components": [
      {
        "id": "caremetrics",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "metrics": [
          {
            "format": "integer",
            "intent": "primary",
            "metric": "encounters",
            "title": "Active Encounters"
          },
          {
            "format": "integer",
            "intent": "success",
            "metric": "patients",
            "title": "Patients Served"
          },
          {
            "format": "integer",
            "intent": "danger",
            "metric": "openalerts",
            "title": "Open Alerts"
          },
          {
            "format": "integer",
            "intent": "warning",
            "metric": "averageresponse",
            "suffix": " min",
            "title": "Avg Response"
          }
        ],
        "span": 5,
        "type": "metricGrid"
      },
      {
        "aggregation": "first",
        "category": "encounterdate",
        "dataset": "daily",
        "height": 250,
        "id": "patientstatistics",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "encounterdate",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "encounters",
        "options": {
          "color": [
            "#2eb7ee"
          ],
          "series": [
            {
              "areaStyle": {
                "opacity": 0.22
              },
              "lineStyle": {
                "width": 3
              },
              "smooth": true,
              "symbolSize": 6
            }
          ]
        },
        "span": 7,
        "title": "Patient Statistics",
        "type": "areaChart"
      },
      {
        "aggregation": "first",
        "category": "reviewtype",
        "dataset": "reviews",
        "height": 245,
        "id": "reviewmix",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "reviewtype",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "reviews",
        "options": {
          "color": [
            "#2eb7ee",
            "#48d9b0",
            "#7b57ef"
          ],
          "series": [
            {
              "radius": [
                "52%",
                "76%"
              ]
            }
          ]
        },
        "span": 4,
        "title": "Patient Reviews",
        "type": "donutChart"
      },
      {
        "aggregation": "first",
        "category": "department",
        "dataset": "departments",
        "height": 245,
        "id": "departmentload",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "department",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "encounters",
        "options": {
          "color": [
            "#48d9b0"
          ],
          "series": [
            {
              "barWidth": 16,
              "itemStyle": {
                "borderRadius": [
                  8,
                  8,
                  2,
                  2
                ]
              }
            }
          ]
        },
        "span": 4,
        "title": "Department Load",
        "type": "barChart"
      },
      {
        "html": "<section class='care-calendar'><header><strong>Care Calendar</strong><span>July 2026</span></header><div class='week'><b>M</b><b>T</b><b>W</b><b>T</b><b>F</b><b>S</b><b>S</b><i>20</i><i>21</i><i>22</i><i>23</i><i>24</i><i>25</i><i class='active'>26</i></div><p>72 encounters are included in this portable sample.</p></section>",
        "id": "carecalendar",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "span": 4,
        "type": "custom"
      },
      {
        "columns": [
          {
            "field": "patientname",
            "title": "Patient"
          },
          {
            "field": "gender",
            "title": "Gender"
          },
          {
            "field": "age",
            "hozAlign": "right",
            "title": "Age"
          },
          {
            "field": "department",
            "title": "Department"
          },
          {
            "cellType": "badge",
            "field": "severity",
            "intentMap": {
              "High": "danger",
              "Low": "success",
              "Moderate": "warning"
            },
            "title": "Severity"
          },
          {
            "field": "responseminutes",
            "format": "integer",
            "hozAlign": "right",
            "title": "Response"
          },
          {
            "cellType": "badge",
            "field": "status",
            "intentMap": {
              "In Review": "primary",
              "Open": "danger",
              "Resolved": "success"
            },
            "title": "Status"
          }
        ],
        "dataset": "activepatients",
        "hover": true,
        "id": "patientapplications",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "encounterid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxRows": 10,
        "pagination": false,
        "span": 12,
        "title": "Patient Applications",
        "type": "table"
      }
    ],
    "css": "\n.hp-app-main { background:#f4f6fb; }\n.hp-page-header { border-bottom:0; background:#f4f6fb; }\n.hp-page-header-title { font-size:20px; letter-spacing:-.03em; }\n.hp-card { border:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric { border:0; border-left:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric-label { text-transform:none; letter-spacing:0; font-size:11px; }\n.hp-metric-value { font-size:23px; }\n.hp-card-header { border-bottom:1px solid color-mix(in srgb,var(--hp-border) 55%,transparent); }\n.hp-table-wrap { border-radius:var(--hp-radius); }\n.hp-app-footer { background:#f4f6fb; border-top:0; }\n\n.hp-app-main{background:#f3f7f8}.hp-component-metricGrid .hp-metric{color:#fff;background:linear-gradient(135deg,#36c4ef,#579df3)}.hp-component-metricGrid .hp-metric:nth-child(2){background:linear-gradient(135deg,#37d7af,#58cfa3)}.hp-component-metricGrid .hp-metric:nth-child(3){background:linear-gradient(135deg,#7257ec,#8e67f5)}.hp-component-metricGrid .hp-metric:nth-child(4){background:linear-gradient(135deg,#49a4f2,#6b7cf0)}.hp-component-metricGrid .hp-metric-label,.hp-component-metricGrid .hp-metric-value{color:#fff}\n.care-calendar{padding:16px;border-radius:14px;background:#fff;box-shadow:0 8px 24px rgb(29 42 68 / 7%)}.care-calendar header{display:flex;justify-content:space-between}.care-calendar header span{color:#8391a3}.care-calendar .week{display:grid;grid-template-columns:repeat(7,1fr);gap:7px;margin:18px 0}.care-calendar b,.care-calendar i{display:grid;place-items:center;height:28px;font-size:10px;font-style:normal}.care-calendar b{color:#98a4b4}.care-calendar i{border-radius:8px;background:#f4f7fa}.care-calendar i.active{background:#2eb7ee;color:#fff}.care-calendar p{margin:0;color:#718094;font-size:10px}\n",
    "data": {
      "datasets": {
        "activepatients": {
          "filter": {
            "field": "status",
            "operator": "!=",
            "value": "Resolved"
          },
          "limit": 10,
          "sort": [
            {
              "direction": "descending",
              "field": "responseminutes"
            }
          ],
          "source": "powerbi"
        },
        "daily": {
          "groupBy": [
            "encounterdate"
          ],
          "metrics": {
            "encounters": {
              "field": "encounterid",
              "op": "count"
            },
            "response": {
              "field": "responseminutes",
              "op": "avg"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "encounterdate"
            }
          ],
          "source": "powerbi"
        },
        "departments": {
          "groupBy": [
            "department"
          ],
          "metrics": {
            "encounters": {
              "field": "encounterid",
              "op": "count"
            }
          },
          "sort": [
            {
              "direction": "descending",
              "field": "encounters"
            }
          ],
          "source": "powerbi"
        },
        "reviews": {
          "groupBy": [
            "reviewtype"
          ],
          "metrics": {
            "reviews": {
              "field": "encounterid",
              "op": "count"
            }
          },
          "source": "powerbi"
        }
      }
    },
    "theme": {
      "accentColor": "#48d9b0",
      "borderColor": "#e0e8ef",
      "cardPadding": 14,
      "dangerColor": "#7b57ef",
      "density": "compact",
      "gap": 12,
      "mode": "light",
      "primaryColor": "#2eb7ee",
      "radius": 14,
      "successColor": "#48d9b0",
      "surfaceColor": "#ffffff",
      "textColor": "#253040",
      "warningColor": "#ffb84d"
    },
    "title": "Patient Care Operations",
    "version": "2.0"
  }
}
