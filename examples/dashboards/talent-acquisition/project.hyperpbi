            "title": "Rejected Candidates"
          },
          {
            "format": "integer",
            "intent": "success",
            "metric": "finalised",
            "title": "Finalised"
          }
        ],
        "span": 12,
        "type": "metricGrid"
      },
      {
        "category": "weekday",
        "dataset": "stagebyday",
        "height": 286,
        "id": "stageflow",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "weekday",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "options": {
          "color": [
            "#6d20ff",
            "#ffb703",
            "#ff7048",
            "#9b8cf5"
          ],
          "series": [
            {
              "barWidth": 10,
              "itemStyle": {
                "borderRadius": [
                  6,
                  6,
                  0,
                  0
                ]
              },
              "stack": "stages"
            },
            {
              "barWidth": 10,
              "stack": "stages"
            },
            {
              "barWidth": 10,
              "stack": "stages"
            },
            {
              "barWidth": 10,
              "stack": "stages"
            }
          ]
        },
        "series": [
          {
            "aggregation": "first",
            "chartType": "bar",
            "field": "applications",
            "label": "Applications"
          },
          {
            "aggregation": "first",
            "chartType": "bar",
            "field": "shortlistedtotal",
            "label": "Shortlisted"
          },
          {
            "aggregation": "first",
            "chartType": "bar",
            "field": "rejectedtotal",
            "label": "Rejected"
          },
          {
            "aggregation": "first",
            "chartType": "bar",
            "field": "holdtotal",
            "label": "On Hold"
          }
        ],
        "span": 8,
        "title": "Statistics of Active Applications",
        "type": "comboChart"
      },
      {
        "aggregation": "first",
        "category": "gender",
        "dataset": "genderbreakdown",
        "height": 286,
        "id": "genderdonut",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "gender",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "applications",
        "options": {
          "color": [
            "#6d20ff",
            "#ff7048",
            "#ffb703"
          ],
          "series": [
            {
              "label": {
                "formatter": "{b}",
                "show": true
              },
              "radius": [
                "56%",
                "78%"
              ]
            }
          ]
        },
        "span": 4,
        "title": "Candidates by Gender",
        "type": "donutChart"
      },
      {
        "aggregation": "first",
        "category": "hourbucket",
        "dataset": "hourly",
        "height": 260,
        "id": "hourlytrend",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "hourbucket",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "measure": "applications",
        "options": {
          "color": [
            "#ff7048"
          ],
          "series": [
            {
              "areaStyle": {
                "opacity": 0.18
              },
              "lineStyle": {
                "width": 3
              },
              "symbolSize": 7
            }
          ]
        },
        "span": 8,
        "title": "Applications Received Time",
        "type": "areaChart"
      },
      {
        "compact": false,
        "dataset": "rolesummary",
        "id": "openroles",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "roleid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxItems": 5,
        "primaryField": "roletitle",
        "secondaryField": "roleid",
        "source": "rows",
        "span": 4,
        "title": "Jobs Posted",
        "type": "listGroup",
        "valueField": "applications"
      },
      {
        "columns": [
          {
            "field": "candidate",
            "title": "Candidate"
          },
          {
            "field": "roletitle",
            "title": "Role"
          },
          {
            "cellType": "badge",
            "field": "stage",
            "intentMap": {
              "Applied": "primary",
              "Finalised": "success",
              "Rejected": "danger",
              "Shortlisted": "warning"
            },
            "title": "Stage"
          },
          {
            "field": "score",
            "hozAlign": "right",
            "title": "Score"
          },
          {
            "field": "city",
            "title": "Location"
          }
        ],
        "dataset": "recent",
        "hover": true,
        "id": "recentapplications",
        "interaction": {
          "clearOnSecondClick": true,
          "enabled": true,
          "externalMode": "selection",
          "field": "applicationid",
          "internalMode": "highlight",
          "internalScope": "others",
          "multiSelect": true,
          "selectionMode": "replace",
          "showSelector": false,
          "trigger": "click"
        },
        "maxRows": 12,
        "pagination": false,
        "span": 12,
        "striped": false,
        "title": "Recent Candidates",
        "type": "table"
      }
    ],
    "css": "\n.hp-app-main { background:#f4f6fb; }\n.hp-page-header { border-bottom:0; background:#f4f6fb; }\n.hp-page-header-title { font-size:20px; letter-spacing:-.03em; }\n.hp-card { border:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric { border:0; border-left:0; box-shadow:0 8px 24px rgb(29 42 68 / 7%); }\n.hp-metric-label { text-transform:none; letter-spacing:0; font-size:11px; }\n.hp-metric-value { font-size:23px; }\n.hp-card-header { border-bottom:1px solid color-mix(in srgb,var(--hp-border) 55%,transparent); }\n.hp-table-wrap { border-radius:var(--hp-radius); }\n.hp-app-footer { background:#f4f6fb; border-top:0; }\n\n.hp-component-metricGrid .hp-metric:nth-child(1){--hp-primary:#6d20ff}.hp-component-metricGrid .hp-metric:nth-child(2){--hp-primary:#ffb703}.hp-component-metricGrid .hp-metric:nth-child(3){--hp-primary:#ff7048}.hp-component-metricGrid .hp-metric:nth-child(4){--hp-primary:#2ec99d}\n.hp-component-metricGrid .hp-metric{position:relative;overflow:hidden;padding:16px 18px}.hp-component-metricGrid .hp-metric::after{content:\"\";position:absolute;right:-12px;top:-18px;width:64px;height:64px;border:10px solid color-mix(in srgb,var(--hp-primary) 18%,transparent);border-radius:50%}\n.hp-list-item{border-radius:9px;margin-bottom:7px;background:#f8f7ff}.hp-list-item-value{padding:4px 9px;border-radius:8px;background:#6d20ff;color:#fff}\n",
    "data": {
      "datasets": {
        "currentapplications": {
          "filter": {
            "field": "period",
            "operator": "=",
            "value": "Current"
          },
          "source": "powerbi"
        },
        "genderbreakdown": {
          "groupBy": [
            "gender"
          ],
          "metrics": {
            "applications": {
              "field": "applicationid",
              "op": "count"
            }
          },
          "source": "currentapplications"
        },
        "hourly": {
          "groupBy": [
            "hourbucket",
            "hourorder"
          ],
          "metrics": {
            "applications": {
              "field": "applicationid",
              "op": "count"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "hourorder"
            }
          ],
          "source": "currentapplications"
        },
        "recent": {
          "limit": 12,
          "sort": [
            {
              "direction": "descending",
              "field": "applicationdate"
            }
          ],
          "source": "currentapplications"
        },
        "rolesummary": {
          "groupBy": [
            "roleid",
            "roletitle"
          ],
          "limit": 5,
          "metrics": {
            "applications": {
              "field": "applicationid",
              "op": "count"
            }
          },
          "sort": [
            {
              "direction": "descending",
              "field": "applications"
            }
          ],
          "source": "currentapplications"
        },
        "stagebyday": {
          "derive": {
            "holdflag": {
              "condition": {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "On Hold"
                }
              },
              "else": {
                "value": 0
              },
              "op": "if",
              "then": {
                "value": 1
              }
            },
            "rejectedflag": {
              "condition": {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "Rejected"
                }
              },
              "else": {
                "value": 0
              },
              "op": "if",
              "then": {
                "value": 1
              }
            },
            "shortlistedflag": {
              "condition": {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "Shortlisted"
                }
              },
              "else": {
                "value": 0
              },
              "op": "if",
              "then": {
                "value": 1
              }
            }
          },
          "groupBy": [
            "weekday",
            "weekdayorder"
          ],
          "metrics": {
            "applications": {
              "field": "applicationid",
              "op": "count"
            },
            "holdtotal": {
              "field": "holdflag",
              "op": "sum"
            },
            "rejectedtotal": {
              "field": "rejectedflag",
              "op": "sum"
            },
            "shortlistedtotal": {
              "field": "shortlistedflag",
              "op": "sum"
            }
          },
          "sort": [
            {
              "direction": "ascending",
              "field": "weekdayorder"
            }
          ],
          "source": "currentapplications"
        }
      }
    },
    "theme": {
      "accentColor": "#ffb703",
      "borderColor": "#e4e5f0",
      "cardPadding": 14,
      "dangerColor": "#ff7048",
      "density": "compact",
      "gap": 12,
      "mode": "light",
      "primaryColor": "#6d20ff",
      "radius": 12,
      "successColor": "#2ec99d",
      "surfaceColor": "#ffffff",
      "textColor": "#252336",
      "warningColor": "#ffb703"
    },
    "title": "Talent Acquisition Command Center",
    "version": "2.0"
  }
}
