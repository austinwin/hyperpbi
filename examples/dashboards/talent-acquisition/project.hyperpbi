    "calculations": {
      "metrics": [
        {
          "aggregation": "countWhere",
          "key": "totalapplications",
          "where": {
            "left": {
              "field": "period"
            },
            "op": "=",
            "right": {
              "value": "Current"
            }
          }
        },
        {
          "aggregation": "countWhere",
          "key": "shortlisted",
          "where": {
            "args": [
              {
                "left": {
                  "field": "period"
                },
                "op": "=",
                "right": {
                  "value": "Current"
                }
              },
              {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "Shortlisted"
                }
              }
            ],
            "op": "and"
          }
        },
        {
          "aggregation": "countWhere",
          "key": "rejected",
          "where": {
            "args": [
              {
                "left": {
                  "field": "period"
                },
                "op": "=",
                "right": {
                  "value": "Current"
                }
              },
              {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "Rejected"
                }
              }
            ],
            "op": "and"
          }
        },
        {
          "aggregation": "countWhere",
          "key": "finalised",
          "where": {
            "args": [
              {
                "left": {
                  "field": "period"
                },
                "op": "=",
                "right": {
                  "value": "Current"
                }
              },
              {
                "left": {
                  "field": "stage"
                },
                "op": "=",
                "right": {
                  "value": "Finalised"
                }
              }
            ],
            "op": "and"
          }
        }
      ]
    },
    "components": [
      {
        "id": "talentmetrics",
        "interaction": {
          "enabled": false,
          "externalMode": "none",
          "internalMode": "none"
        },
        "metrics": [
          {
            "format": "integer",
            "intent": "primary",
            "metric": "totalapplications",
            "title": "Total Applications"
          },
          {
            "format": "integer",
            "intent": "warning",
            "metric": "shortlisted",
            "title": "Shortlisted Candidates"
          },
          {
            "format": "integer",
            "intent": "danger",
