    },
    {
      "type": "table",
      "id": "mediumperformance",
      "dataset": "media",
      "title": "Performance by Medium",
      "span": 8,
      "columns": [
        {
          "field": "medium",
          "title": "Medium"
        },
        {
          "field": "conversions",
          "title": "Conversions",
          "format": "integer",
          "hozAlign": "right"
        },
        {
          "field": "conversionrate",
          "title": "Conversion rate",
          "format": "percent",
          "hozAlign": "right"
        },
        {
          "field": "sessions",
          "title": "Sessions",
          "format": "integer",
          "hozAlign": "right"
        }
      ],
      "pagination": false,
      "maxRows": 8,
      "interaction": {
        "enabled": true,
        "trigger": "click",
        "internalMode": "highlight",
        "internalScope": "others",
        "externalMode": "selection",
        "field": "medium",
        "selectionMode": "replace",
        "multiSelect": true,
        "showSelector": false,
        "clearOnSecondClick": true
