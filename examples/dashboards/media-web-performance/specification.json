            }
          }
        },
        "yAxis": {
          "axisLabel": {
            "color": "#758aa5"
          },
          "splitLine": {
            "lineStyle": {
              "color": "#1c2b40"
            }
          },
          "axisLine": {
            "lineStyle": {
              "color": "#263852"
            }
          }
        },
        "series": [
          {
            "min": 0,
            "max": 100,
            "startAngle": 180,
            "endAngle": 0,
            "center": [
              "50%",
              "68%"
            ],
            "radius": "90%",
            "progress": {
              "show": true,
              "width": 13,
              "itemStyle": {
                "color": "#21d4fd"
              }
            },
            "axisLine": {
              "lineStyle": {
                "width": 13,
                "color": [
                  [
                    1,
                    "#444a76"
                  ]
                ]
              }
            },
            "pointer": {
              "length": "58%",
              "width": 5,
              "itemStyle": {
                "color": "#f4f5ff"
              }
            },
            "axisTick": {
              "show": false
            },
            "splitLine": {
              "show": false
            },
            "axisLabel": {
              "show": false
            },
            "detail": {
              "formatter": "{value}%",
              "color": "#f4f5ff",
              "fontSize": 24
            },
            "title": {
              "show": false
            }
          }
        ]
      },
      "interaction": {
        "enabled": false,
        "internalMode": "none",
        "externalMode": "none"
      }
    },
    {
      "type": "listGroup",
      "id": "livelocations",
      "dataset": "locations",
      "title": "User Locations · Live",
      "span": 12,
      "source": "rows",
      "primaryField": "location",
      "secondaryField": "recordid",
      "valueField": "sessions",
      "maxItems": 8,
      "compact": true,
      "interaction": {
        "enabled": true,
        "trigger": "click",
