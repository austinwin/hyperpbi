      "dataset": "summary",
      "title": "Bounce rate · 7 day",
      "span": 4,
      "height": 210,
      "measure": "bouncerate",
      "aggregation": "first",
      "options": {
        "color": [
          "#21d4fd"
        ],
        "textStyle": {
          "color": "#dce8f8"
        },
        "legend": {
          "textStyle": {
