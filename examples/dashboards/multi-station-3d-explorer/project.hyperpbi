  "format": "hyperpbi-playground-project",
  "formatVersion": 1,
  "metadata": {
    "createdAt": "2026-07-25T00:00:00.000Z",
    "id": "example-multi-station-3d-explorer",
    "name": "Multi-Station 3D Explorer",
    "updatedAt": "2026-07-25T00:00:00.000Z"
  },
  "runtimeConfiguration": {
    "bindings": {
      "map": {}
    },
    "fields": {
      "aliases": {}
    },
    "interactions": {
      "crossFilter": true,
      "externalMode": "auto",
      "multiSelect": true
    },
    "motion": {
      "enabled": true,
      "maxConcurrentAnimations": 8,
      "reducedMotion": "respect-system"
    },
    "providers": {
      "basemap": {
        "enabled": false,
        "provider": "none"
      },
      "geocoder": {
        "autocomplete": false,
        "cache": true,
        "enabled": false,
        "minScore": 80,
        "provider": "none",
        "userTriggeredOnly": true
      },
      "mode": "core",
      "privacyAcknowledged": false
    },
    "renderer": {
      "showHeader": false,
      "showRowCount": false,
      "showStudioButton": true
    },
    "security": {
      "cssMode": "scoped",
      "htmlMode": "sanitized",
      "showSanitizerWarnings": false,
      "svgMode": "sanitized"
    },
    "version": "1.0"
  },
  "specification": {
    "components": [
      {
        "id": "station_intro",
        "text": "# Multi-Station 3D Explorer\nAlder Basin Water · Synthetic facility layouts and operating data",
        "type": "markdown"
      },
      {
        "dataset": "stations",
        "defaultValue": "GW-001",
        "field": "stationid",
        "id": "station_picker",
        "interaction": {
          "externalMode": "none",
          "field": "stationid",
          "internalMode": "filter",
          "multiSelect": false,
          "stateKey": "selectedStationId",
          "targets": [
            "station_profile",
            "station_scene",
            "daily_pumpage",
            "daily_availability",
            "station_history"
          ]
        },
        "label": "Station",
        "options": [
          {
            "label": "Groundwater Station 01",
            "value": "GW-001"
          },
          {
            "label": "Groundwater Station 02",
            "value": "GW-002"
          },
          {
            "label": "Repump Station 01",
            "value": "RP-001"
          }
        ],
        "span": 6,
        "type": "select"
      },
      {
        "defaultValue": 8,
        "field": "day",
        "id": "reporting_day",
        "interaction": {
          "externalMode": "none",
          "field": "day",
          "internalMode": "filter",
          "stateKey": "reportingDay",
          "targets": [
            "daily_pumpage",
            "daily_availability",
            "station_scene"
          ]
        },
        "label": "October 2026 · reporting day",
        "max": 8,
        "min": 1,
        "span": 6,
        "step": 1,
        "type": "slider"
      },
      {
        "dataset": "stations",
        "id": "station_profile",
        "items": [
          {
            "field": "stationname",
            "label": "Station"
          },
          {
            "field": "stationtype",
            "label": "Process"
          },
          {
            "field": "location",
            "label": "District"
          }
        ],
        "span": 6,
        "title": "Facility profile",
        "type": "statList"
      },
      {
        "dataset": "daily",
        "field": "pumpagemgd",
        "id": "daily_pumpage",
        "span": 3,
        "title": "Daily pumpage · MGD",
        "type": "kpi"
      },
      {
        "dataset": "daily",
        "id": "daily_availability",
        "items": [
          {
            "field": "availability",
            "label": "Availability"
          },
          {
            "field": "reportdate",
            "label": "Date"
          }
        ],
        "span": 3,
        "title": "Daily reading",
        "type": "statList"
      },
      {
        "dataset": "equipment",
        "height": 510,
        "id": "station_scene",
        "interaction": {
          "externalMode": "none",
          "internalMode": "none"
        },
        "sceneBinding": {
          "dataset": "scenes",
          "keyField": "stationid",
          "mode": "data",
          "sceneField": "scenejson",
          "selectedKeyState": "selectedStationId"
        },
        "showLabels": true,
        "showObjectList": true,
        "span": 8,
        "title": "Process layout",
        "type": "scene3d"
      },
      {
        "basemap": {
          "type": "none"
        },
        "css": ".hp-leaflet-container,.hp-map-viewport-clip { background-color: #152b3d }",
        "height": 510,
        "id": "station_map",
        "interaction": {
          "externalMode": "none",
          "field": "stationid",
          "internalMode": "filter",
          "multiSelect": false,
          "stateKey": "selectedStationId",
          "targets": [
            "station_profile",
            "station_scene",
            "daily_pumpage",
            "daily_availability",
            "station_history"
          ]
        },
        "layers": [
          {
            "id": "district",
            "interaction": {
              "enabled": false,
              "externalMode": "none"
            },
            "name": "Fictional service area",
            "popup": {
              "mode": "none"
            },
            "renderer": {
              "symbol": {
                "fillColor": "#52758c",
                "fillOpacity": 0.22,
                "outlineColor": "#62859a",
                "outlineWidth": 1
              },
              "type": "simple"
            },
            "source": {
              "data": {
                "features": [
                  {
                    "geometry": {
                      "coordinates": [
                        [
                          [
                            -134.112,
                            44.154
                          ],
                          [
                            -134.084,
                            44.187
                          ],
                          [
                            -134.004,
                            44.168
                          ],
                          [
                            -133.995,
                            44.126
                          ],
                          [
                            -134.038,
                            44.092
                          ],
                          [
                            -134.096,
                            44.109
                          ],
                          [
                            -134.112,
                            44.154
                          ]
                        ]
                      ],
                      "type": "Polygon"
                    },
                    "properties": {},
                    "type": "Feature"
                  }
                ],
                "type": "FeatureCollection"
              },
              "type": "geoJson"
            }
          },
          {
            "dataset": "stations",
            "id": "facilities",
            "labels": {
              "color": "#d7eaf4",
              "enabled": true,
              "field": "stationid",
              "placement": "right",
              "size": 12
            },
            "name": "Stations",
            "popup": {
              "mode": "none"
            },
            "renderer": {
              "symbol": {
                "fillColor": "#62aee9",
                "fillOpacity": 0.85,
                "outlineColor": "#e5f3fa",
                "outlineWidth": 2,
                "shape": "circle",
                "size": 16
              },
              "type": "simple"
            },
            "source": {
              "bindings": {
                "latitude": "latitude",
                "longitude": "longitude"
              },
              "type": "powerbi"
            },
            "tooltip": {
              "enabled": true,
              "template": "{{powerbi.stationname}} · {{powerbi.location}}"
            }
          }
        ],
        "span": 4,
        "title": "Alder Basin · station locations",
        "toolbar": {
          "home": true,
          "visible": true,
          "zoomIn": true,
          "zoomOut": true
        },
        "type": "map",
        "view": {
          "center": [
            44.14,
            -134.054
          ],
          "fitMode": "none",
          "zoom": 12
        }
      },
      {
        "ariaLabel": "Searchable station register",
        "columns": [
          {
            "field": "stationname",
            "title": "Station"
          },
          {
            "field": "location",
            "title": "District"
          }
        ],
        "dataset": "stations",
        "id": "station_register",
        "interaction": {
          "externalMode": "none",
          "field": "stationid",
          "internalMode": "filter",
          "multiSelect": false,
          "stateKey": "selectedStationId",
          "targets": [
            "station_profile",
            "station_scene",
            "daily_pumpage",
            "daily_availability",
            "station_history"
          ]
        },
        "maxRows": 10,
        "pagination": false,
        "search": true,
        "span": 5,
        "title": "Find a station",
        "type": "table"
      },
      {
        "aggregation": "first",
        "category": "reportdate",
        "dataset": "history",
        "height": 260,
        "id": "station_history",
        "interaction": {
          "enabled": false,
          "externalMode": "none"
        },
        "measure": "pumpagemgd",
        "options": {
          "color": [
            "#72c9e8"
          ],
          "series": [
            {
              "areaStyle": {
                "opacity": 0.13
              },
              "connectNulls": false,
              "lineStyle": {
                "width": 3
              },
              "symbolSize": 7
            }
          ]
        },
        "span": 7,
        "title": "Daily pumpage history · available days · MGD",
        "type": "lineChart"
      },
      {
        "id": "station_legend",
        "text": "Teal pipes carry raw water. Blue pipes carry treated water. Amber and violet lines mark chlorine and ammonia injection. Moving bands show flow from the simulated equipment readings.",
        "type": "text"
      }
    ],
    "data": {
      "datasets": {
        "daily": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Daily"
          },
          "sort": [
            {
              "direction": "asc",
              "field": "day"
            }
          ],
          "source": "powerbi"
        },
        "equipment": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Equipment"
          },
          "select": [
            "stationid",
            "day",
            "assetid",
            "equipmentstatus",
            "rpm",
            "levelpct",
            "flowgpm"
          ],
          "source": "powerbi"
        },
        "history": {
          "filter": {
            "field": "availability",
            "operator": "=",
            "value": "Synthetic daily reading"
          },
          "source": "daily"
        },
        "scenes": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Scene"
          },
          "select": [
            "stationid",
            "scenejson"
          ],
          "source": "powerbi"
        },
        "stations": {
          "filter": {
            "field": "recordtype",
            "operator": "=",
            "value": "Scene"
          },
          "select": [
            "stationid",
            "stationname",
            "stationtype",
            "location",
            "latitude",
            "longitude"
          ],
          "source": "powerbi"
        }
      }
    },
    "theme": {
      "accentColor": "#72c9e8",
      "cardPadding": 16,
      "gap": 14,
      "mode": "dark",
      "radius": 12
    },
    "title": "Multi-Station 3D Explorer",
    "version": "2.0"
  }
}
