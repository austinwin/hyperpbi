{
  "name": "hyperpbi",
  "description": "AI-native analytics runtime and portable dashboard specification for Power BI and the web",
  "version": "1.0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/austinwin/hyperpbi.git"
  },
  "homepage": "https://hyperpbi.com",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "npm run package:core",
    "package:core": "node scripts/package-profile.mjs core",
    "package:maps": "node scripts/package-profile.mjs maps",
    "package:verify": "node scripts/verify-package-capabilities.mjs",
    "geolibre:build": "node scripts/build-geolibre-runtime.mjs",
    "geolibre:build:cached": "node scripts/build-geolibre-runtime.mjs --skip-install",
    "docs:generate": "node scripts/generate-documentation.mjs",
    "docs:check": "node scripts/generate-documentation.mjs --check",
    "examples:generate": "node scripts/generate-dashboard-examples.mjs",
    "examples:check": "vitest run tests/dashboard-examples.test.ts",
    "schema:migrate-v1": "node scripts/migrate-schema-v1-to-v2.mjs",
    "dev": "npm run web:dev",
    "build": "npm run typecheck && npm run web:typecheck && npm run web:build",
    "certification:audit": "node scripts/package-profile.mjs core audit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "playground:dev": "vite --config apps/playground/vite.config.mts",
    "playground:typecheck": "tsc -p apps/playground/tsconfig.json --noEmit",
    "playground:test": "vitest run tests/file-import.test.ts tests/data-workspace.test.ts tests/browser-host.test.ts tests/project-storage.test.ts tests/playground-export.test.ts tests/powerbi-portability.test.ts tests/playground-play-mode.test.tsx",
    "playground:test:browser": "playwright test --config apps/playground/playwright.config.ts",
    "playground:build": "vite build --config apps/playground/vite.config.mts",
    "playground:preview": "vite preview --config apps/playground/vite.config.mts",
    "web:runtime:build": "vite build --config apps/web/runtime/vite.config.mts",
    "web:runtime:typecheck": "tsc -p apps/web/runtime/tsconfig.json --noEmit",
    "web:dev": "npm run web:runtime:build && npm --workspace @hyperpbi/web run dev",
    "web:typecheck": "npm run web:runtime:typecheck && npm --workspace @hyperpbi/web run typecheck",
    "web:build": "npm run web:runtime:build && npm --workspace @hyperpbi/web run build",
    "web:cloudflare:build": "npm run web:runtime:build && npm --workspace @hyperpbi/web run cloudflare:build",
    "web:cloudflare:preview": "npm run web:runtime:build && npm --workspace @hyperpbi/web run cloudflare:preview",
    "web:sites:build": "npm run geolibre:build && npm run web:runtime:build && npm --workspace @hyperpbi/web run sites:build",
    "web:start": "npm --workspace @hyperpbi/web run start"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@e965/xlsx": "^0.20.3",
    "@geolibre/embed": "2.5.0",
    "@tabler/core": "^1.4.0",
    "@types/d3": "7.4.3",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "css-tree": "^3.2.1",
    "d3": "7.9.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "postcss": "8.5.23",
    "powerbi-visuals-api": "~5.11.0",
    "powerbi-visuals-utils-formattingmodel": "6.0.4",
    "preact": "^10.29.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.2",
    "@types/css-tree": "^2.3.11",
    "@types/jsdom": "^28.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "esbuild": "0.25.12",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "postcss-prefix-selector": "^2.1.1",
    "powerbi-visuals-tools": "^6.1.3",
    "typescript": "5.5.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hyperpbi/web": {
      "next": {
        "postcss": "$postcss",
        "sharp": "$sharp"
      }
    },
    "fast-uri": "3.1.4",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
